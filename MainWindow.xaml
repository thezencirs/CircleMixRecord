                                        <!-- Kanal 3 -->
                                        <CheckBox x:Name="ChkDestStream3" Content="Circle Yayın Kanalı 3 (Alternatif Akış)" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtDestStream3Url" Background="#140E38" Foreground="#B8B0DC" BorderBrush="#342580" Padding="6,3" FontSize="10.5" Margin="0,0,0,3" ToolTip="3. Yayın Kanalı RTMP/RTMPS Sunucu Adresi"/>
                                        <PasswordBox x:Name="PwdDestStream3" Background="#140E38" Foreground="#FFFFFF" BorderBrush="#342580" Padding="6,4" Margin="0,0,0,8" ToolTip="3. Yayın Kanalı RTMP Yayın Anahtarı"/>

                                        <!-- Özel Kanal 4 -->
                                        <CheckBox x:Name="ChkDestCustom" Content="Circle Özel RTMP Sunucusu" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtDestCustomUrl" Background="#140E38" Foreground="#B8B0DC" BorderBrush="#342580" Padding="6,3" FontSize="10.5" Margin="0,0,0,3" ToolTip="rtmp:// veya rtmps:// sunucu adresi"/>
                                        <PasswordBox x:Name="PwdDestCustom" Background="#140E38" Foreground="#FFFFFF" BorderBrush="#342580" Padding="6,4" Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CmbStreamOrientation" Grid.Column="0" Height="26" SelectedIndex="0" ToolTip="Yayın yönü">
                                                <ComboBoxItem Content="Yatay 16:9"/>
                                                <ComboBoxItem Content="Dikey 9:16"/>
                                            </ComboBox>
                                            <ComboBox x:Name="CmbStreamResolution" Grid.Column="2" Height="26" SelectedIndex="0" ToolTip="Çözünürlük">
                                                <ComboBoxItem Content="1080p"/>
                                                <ComboBoxItem Content="720p"/>
                                            </ComboBox>
                                            <ComboBox x:Name="CmbStreamBitrate" Grid.Column="4" Height="26" SelectedIndex="2" ToolTip="Video bit hızı (internet yükleme hızınızın ~%70'ini geçmesin)">
                                                <ComboBoxItem Content="3000 kbps"/>
                                                <ComboBoxItem Content="4500 kbps"/>
                                                <ComboBoxItem Content="6000 kbps"/>
                                                <ComboBoxItem Content="8000 kbps"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Mikrofon seviyesi (yayın)" FontSize="10.5" Foreground="#B8B0DC"/>
                                            <TextBlock x:Name="TxtStreamMicVal" Text="%100" FontSize="10.5" FontWeight="SemiBold" Foreground="#EF5F18" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="SldStreamMic" Minimum="0" Maximum="200" Value="100" ValueChanged="StreamMix_Changed" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Masaüstü sesi (yayın)" FontSize="10.5" Foreground="#B8B0DC"/>
                                            <TextBlock x:Name="TxtStreamSysVal" Text="%55" FontSize="10.5" FontWeight="SemiBold" Foreground="#EF5F18" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="SldStreamSys" Minimum="0" Maximum="200" Value="55" ValueChanged="StreamMix_Changed" Margin="0,0,0,8"/>

                                        <Button x:Name="BtnToggleRtmp" Content="● Yayını Başlat" Click="BtnToggleRtmp_Click" Padding="10,8" FontWeight="Bold" Background="#EF5F18" BorderBrush="#EF5F18" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button x:Name="BtnToggleIntermission" Content="⏸ Bekleme Ekranı (Alt+Shift+B)" Click="BtnToggleIntermission_Click" Margin="0,0,6,4"/>
                                            <Button Content="Bekleme Görseli Seç" Click="BtnPickIntermissionImage_Click" Margin="0,0,6,4"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="TxtStreamStats" Text="Yayın kapalı" FontSize="10.5" Foreground="#B8B0DC" TextWrapping="Wrap"/>
                                        <!-- Geriye dönük uyumluluk için gizli alan -->
                                        <TextBox x:Name="TxtRtmpUrl" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ======================= KATMAN A: GENEL BAKIŞ & HIZLI BAĞLANTI (CIRCLE MINIMAL LAUNCHPAD) ======================= -->
            <Border x:Name="OverlayWelcome" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#F5140E38" CornerRadius="14" Visibility="Collapsed" Padding="36">
                <Border MaxWidth="820" MaxHeight="470" Background="#1C134C" BorderBrush="#342580" BorderThickness="1" CornerRadius="18" Padding="36" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Circle" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Stüdyo, Toplantı ve Kurgu  •  by thezencirs" FontSize="13" Foreground="#B8B0DC" HorizontalAlignment="Center" Margin="0,4,0,28"/>

                        <UniformGrid Columns="2" Rows="2" Height="250">
                            <Border Background="#261A66" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" Margin="6" Padding="18">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Stüdyo Kaydı" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                        <TextBlock Text="Eşzamanlı 16:9 yatay ve 9:16 dikey kayıt." FontSize="12" Foreground="#B8B0DC" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Content="Stüdyoyu Aç" Click="BtnWelcomeStartRecord_Click"
                                            Background="#EF5F18" BorderBrush="#EF5F18" VerticalAlignment="Bottom" HorizontalAlignment="Left" Padding="16,7"/>
                                </Grid>
                            </Border>

                            <Border Background="#261A66" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" Margin="6" Padding="18">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Circle Meet" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtWelcomeJoinCode" Grid.Column="0" Text="" ToolTip="6 haneli oda kodu"
                                                     Background="#140E38" Foreground="#FFFFFF" BorderBrush="#342580" FontWeight="SemiBold" Padding="7,4" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Content="Bağlan" Click="BtnWelcomeConnectByCode_Click" Background="#EF5F18" BorderBrush="#EF5F18" Padding="12,4"/>
                                        </Grid>
                                    </StackPanel>
                                    <Button x:Name="BtnWelcomeStartMeet" Content="Odamı Aç" Click="BtnWelcomeStartMeet_Click"
                                            Background="#140E38" BorderBrush="#342580" VerticalAlignment="Bottom" HorizontalAlignment="Left" Padding="16,7"/>
                                </Grid>
                            </Border>

                            <Border Background="#261A66" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" Margin="6" Padding="18">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Kurgu &amp; Timelapse" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                        <TextBlock Text="Kesme, sessizlik silme ve 30x Timelapse." FontSize="12" Foreground="#B8B0DC" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Content="Kurguyu Aç" Click="BtnModeEdit_Click"
                                            Background="#140E38" BorderBrush="#342580" VerticalAlignment="Bottom" HorizontalAlignment="Left" Padding="16,7"/>
                                </Grid>
                            </Border>

                            <Border Background="#261A66" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" Margin="6" Padding="18">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Paylaşım" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                        <TextBlock Text="Otomatik bölüm damgaları ve hızlı aktarım." FontSize="12" Foreground="#B8B0DC" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Content="Paylaşımı Aç" Click="BtnModeSocial_Click"
                                            Background="#140E38" BorderBrush="#342580" VerticalAlignment="Bottom" HorizontalAlignment="Left" Padding="16,7"/>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ======================= KATMAN B: MINIMAL PAYLAŞIM EKRANI ======================= -->
            <Border x:Name="OverlaySocial" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#F5140E38" CornerRadius="14" Visibility="Collapsed" Padding="28">
                <Border MaxWidth="920" Background="#1C134C" BorderBrush="#342580" BorderThickness="1" CornerRadius="18" Padding="30" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Paylaşım" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                            <TextBlock Text="-14 LUFS ses dengelemesi ve bölüm zaman damgaları hazır."
                                       FontSize="12" Foreground="#B8B0DC" Margin="0,0,0,16"/>

                            <TextBlock Text="Başlık" FontSize="11.5" Foreground="#B8B0DC" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtSocialTitle" Text="3B Mimari Modelleme &amp; Tasarım — Circle Studio"
                                     Background="#140E38" Foreground="#FFFFFF" BorderBrush="#342580" Padding="9,7" FontSize="12.5" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Açıklama &amp; Bölümler" FontSize="11.5" Foreground="#B8B0DC"/>
                                <Button Content="Yenile" Click="BtnRegenerateSocialMeta_Click" HorizontalAlignment="Right" Padding="9,2" FontSize="10.5"/>
                            </Grid>
                            <TextBox x:Name="TxtSocialCaption" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="#140E38" Foreground="#FFFFFF" BorderBrush="#342580" Padding="9" FontSize="12" Margin="0,0,0,14"/>

                            <WrapPanel>
                                <Button Content="Videoları Dışa Aktar (16:9 + 9:16)" Click="BtnExportAll_Click"
                                        Background="#EF5F18" BorderBrush="#EF5F18" Padding="16,9" Margin="0,0,8,0"/>
                                <Button Content="Metni Kopyala" Click="BtnCopySocialText_Click" Padding="14,9"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Hızlı Paket &amp; Klasör" FontSize="12.5" FontWeight="SemiBold" Foreground="#B8B0DC" Margin="0,0,0,10"/>

                            <Button Content="Circle 16:9 Geniş Ekran Paketi"
                                    Click="BtnShareWide16x9_Click" Background="#261A66" BorderBrush="#EF5F18"
                                    Padding="14,11" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>

                            <Button Content="Circle 9:16 Dikey Video Paketi"
                                    Click="BtnShareVertical9x16_Click" Background="#261A66" BorderBrush="#342580"
                                    Padding="14,11" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>

                            <Button Content="Circle 9:16 Kısa Klip Paketi"
                                    Click="BtnShareShort9x16_Click" Background="#261A66" BorderBrush="#342580"
                                    Padding="14,11" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>

                            <Button Content="Circle Masaüstü &amp; Hızlı Paylaşım"
                                    Click="BtnShareDirectDesktop_Click" Background="#261A66" BorderBrush="#342580"
                                    Padding="14,11" Margin="0,0,0,14" HorizontalContentAlignment="Left"/>

                            <Button Content="Stüdyoya Dön" Click="BtnModeRecord_Click" Background="#140E38" Padding="12,8"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- ======================= ALT TIMELINE (YALIN VE NET) ======================= -->
        <Border x:Name="BdrTimelinePanel" Grid.Row="2" Background="#1C134C" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" Margin="12,4,12,10" Padding="12,8"
                AllowDrop="True" DragOver="CircleEditDropZone_DragOver" Drop="CircleEditDropZone_Drop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="6" Padding="9,3" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtTimelineTimecode" Text="00:00.0 / 00:00.0" FontFamily="Consolas" FontWeight="SemiBold" FontSize="11.5" Foreground="#FFFFFF"/>
                        </Border>
                        <Button x:Name="BtnTimelinePlayPause" Content="▶ Oynat" Click="BtnPlayerPlayPause_Click" Background="#EF5F18" BorderBrush="#EF5F18" Padding="12,4" Margin="0,0,5,0"/>
                        <Button Content="Kes" Click="BtnSplitClip_Click" Padding="10,4" Margin="0,0,5,0" ToolTip="Seçili saniyeden böl (S / Ctrl+B)"/>
                        <Button Content="Sil" Click="BtnToggleDeleteClip_Click" Padding="10,4" Margin="0,0,5,0" ToolTip="Seçili klibi sil (Del)"/>
                        <Button Content="◀" Click="BtnMoveClipLeft_Click" Padding="8,4" Margin="0,0,3,0" ToolTip="Seçili klibi sola taşı"/>
                        <Button Content="▶" Click="BtnMoveClipRight_Click" Padding="8,4" Margin="0,0,5,0" ToolTip="Seçili klibi sağa taşı"/>
                        <Button Content="Kare Al" Click="BtnGrabEditorFrame_Click" Padding="10,4" Margin="0,0,5,0" ToolTip="Bu saniyedeki kareyi net PNG olarak çıkar"/>
                        <Button Content="Sessizliği Kes" Click="BtnRippleDeleteSilence_Click" Padding="11,4" Margin="0,0,5,0"/>
                        <Button Content="8x Hız" Click="BtnSpeedUpSilence_Click" Padding="10,4" Margin="0,0,5,0"/>
                        <Button Content="Geri Al" Click="BtnUndoEdit_Click" Padding="10,4"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtTimelineStats" Grid.Column="1"
                               Text="Timeline"
                               VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" Foreground="#B8B0DC"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#261A66" BorderBrush="#FFFFFF" BorderThickness="1" Width="9" Height="9" CornerRadius="2" Margin="4,0"/>
                        <TextBlock Text="Klip " FontSize="11" Foreground="#B8B0DC" VerticalAlignment="Center"/>
                        <Border Background="#EF5F18" Width="9" Height="9" CornerRadius="2" Margin="8,0,4,0"/>
                        <TextBlock Text="Timelapse" FontSize="11" Foreground="#B8B0DC" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="9" ClipToBounds="True"
                        AllowDrop="True" DragOver="CircleEditDropZone_DragOver" Drop="CircleEditDropZone_Drop">
                    <Canvas x:Name="TimelineCanvas" Background="Transparent"
                            MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                            MouseMove="TimelineCanvas_MouseMove"
                            MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp"
                            SizeChanged="TimelineCanvas_SizeChanged"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
