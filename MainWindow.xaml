                                    <TextBlock Text="CIRCLE TIMELAPSE &amp; HIZ:" FontWeight="ExtraBold" FontSize="11" Foreground="#EF5F18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="0.5x" Click="BtnSpeed05x_Click" Padding="8,4" FontSize="11" Margin="2"/>
                                    <Button Content="1x Normal" Click="BtnSpeed1x_Click" Padding="8,4" FontSize="11" Margin="2"/>
                                    <Button Content="2x Hızlı" Click="BtnSpeed2x_Click" Padding="8,4" FontSize="11" Margin="2"/>
                                    <Button Content="4x Timelapse" Click="BtnSpeed4x_Click" Padding="8,4" FontSize="11" Margin="2"/>
                                    <Button Content="8x Timelapse" Click="BtnSpeed8x_Click" Padding="8,4" FontSize="11" Margin="2"/>
                                    <Button Content="16x Timelapse" Click="BtnSpeed16x_Click" Padding="8,4" FontSize="11" Margin="2"/>
                                    <Button Content="30x Ultra Timelapse" Click="BtnSpeed30x_Click" Padding="8,4" FontSize="11" Margin="2"/>
