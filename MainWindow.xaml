                            <Button x:Name="BtnRecordVoiceover" Content="🎙️ Seslendirme" Click="BtnRecordVoiceover_Click"
                                    Background="#261A66" BorderBrush="#EF5F18" Padding="10,4" FontSize="11" Margin="0,0,4,0"
                                    ToolTip="Videonun üzerine canlı mikrofonunuzla seslendirme / dublaj kaydedin"/>
                            <Button Content="🎵 Beat Yakala" Click="BtnDetectBeats_Click"
                                    Background="#261A66" BorderBrush="#342580" Padding="10,4" FontSize="11" Margin="0,0,4,0"
                                    ToolTip="Müzik ve ses vuruşlarını analiz edip Timeline üzerine otomatik BEAT işaretleri yerleştirir"/>
                            <Button Content="🔊 Sesi Ayır" Click="BtnExtractAudio_Click"
                                    Background="#261A66" BorderBrush="#342580" Padding="10,4" FontSize="11" Margin="0,0,4,0"
