                                </Grid>
                                <Slider x:Name="SldSilenceDur" Minimum="0.25" Maximum="2.0" Value="0.55" ValueChanged="SilenceParams_Changed" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Nefes Payı" FontSize="11.5" Foreground="#B8B0DC"/>
                                    <TextBlock x:Name="TxtSilencePadVal" Text="150 ms" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldSilencePad" Minimum="50" Maximum="400" Value="150" ValueChanged="SilenceParams_Changed" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Sessiz Bölüm Hızı" FontSize="11.5" Foreground="#B8B0DC"/>
