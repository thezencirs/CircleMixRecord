                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                            <StackPanel>
                                <TextBlock Text="CIRCLE PRO KURGU: MEDYA, MASKELEME &amp; BİRLEŞTİRME" FontWeight="Bold" FontSize="11.5" Foreground="#EF5F18" Margin="0,2,0,6"/>

                                <!-- 1. Dışarıdan Video Ekle & Birleştir -->
                                <Border Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="1. Dışarıdan Video Ekle &amp; Birleştir (Intro / Ek Sahne):" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Video Seç &amp; Birleştir (.mp4/.mov)" Click="BtnAddMergeVideo_Click" Background="#EF5F18" BorderBrush="#FFFFFF" Padding="8,5" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Content="Temizle" Click="BtnClearMergedVideos_Click" Background="#140E38" Padding="8,5"/>
                                        </Grid>
                                        <TextBlock x:Name="TxtMergedVideosStatus" Text="Birleştirilecek ek video seçilmedi." FontSize="10.5" Foreground="#C5BEE8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Görüntü / Video Bindirme (PIP Overlay) & Maskeleme -->
                                <Border Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="2. Görüntü / B-Roll Bindirme (PIP) &amp; Maskeleme:" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Resim / Video Bindir (.png/.jpg/.mp4)" Click="BtnSelectPipMedia_Click" Background="#140E38" BorderBrush="#EF5F18" Padding="8,5" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Content="Kaldır" Click="BtnClearPipMedia_Click" Background="#140E38" Padding="8,5"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CmbPipMaskShape" Grid.Column="0" Height="26" SelectedIndex="0" SelectionChanged="PipOptions_Changed">
                                                <ComboBoxItem Content="Yuvarlatılmış Kart"/>
                                                <ComboBoxItem Content="Daire Maske (Circle)"/>
                                                <ComboBoxItem Content="Yeşil Perde Sil (Chroma)"/>
                                                <ComboBoxItem Content="Yarı Saydam Filigran"/>
                                            </ComboBox>
                                            <ComboBox x:Name="CmbPipPosition" Grid.Column="2" Height="26" SelectedIndex="0" SelectionChanged="PipOptions_Changed">
                                                <ComboBoxItem Content="Sol Üst"/>
                                                <ComboBoxItem Content="Sağ Üst"/>
                                                <ComboBoxItem Content="Sol Alt"/>
                                                <ComboBoxItem Content="Sağ Alt"/>
                                                <ComboBoxItem Content="Merkez"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Bindirme Boyutu:" FontSize="10.5" Foreground="#C5BEE8"/>
                                            <TextBlock x:Name="TxtPipScaleVal" Text="%28" FontSize="10.5" FontWeight="Bold" Foreground="#EF5F18" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="SldPipScale" Minimum="14" Maximum="65" Value="28" ValueChanged="PipScale_Changed"/>
                                        <TextBlock x:Name="TxtPipMediaStatus" Text="Aktif bindirme yok." FontSize="10" Foreground="#C5BEE8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Dışarıdan Ses / Arka Plan Müziği Ekle & Circle Renk Filtresi -->
                                <Border Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="3. Dışarıdan Ses / Müzik Ekle &amp; Circle LUT Filtresi:" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Müzik / Ses Ekle (.mp3/.wav)" Click="BtnSelectExternalAudio_Click" Background="#140E38" BorderBrush="#EF5F18" Padding="8,5" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Content="Sil" Click="BtnClearExternalAudio_Click" Background="#140E38" Padding="8,5"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,2">
                                            <TextBlock x:Name="TxtExternalAudioStatus" Text="Fon Müziği Ses Oranı (Konuşma Altı):" FontSize="10.5" Foreground="#C5BEE8"/>
                                            <TextBlock x:Name="TxtBgmVolVal" Text="%18" FontSize="10.5" FontWeight="Bold" Foreground="#EF5F18" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="SldBgmVolume" Minimum="5" Maximum="80" Value="18" ValueChanged="BgmVolume_Changed" Margin="0,0,0,6"/>

                                        <TextBlock Text="Circle Renk &amp; Keskinlik Filtresi:" FontSize="10.5" Foreground="#C5BEE8" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="CmbColorFilter" Height="26" SelectedIndex="0" SelectionChanged="ColorFilter_Changed">
                                            <ComboBoxItem Content="1. Doğal Stüdyo (Orijinal)"/>
                                            <ComboBoxItem Content="2. Circle Sinematik Kontrast"/>
                                            <ComboBoxItem Content="3. Sıcak Altın Saat (Warm LUT)"/>
                                            <ComboBoxItem Content="4. 3B CAD / Mimari Keskin Çizgi Modu"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- 4. Hedef Süre, -14 LUFS Ses & Otomatik Altyazı -->
                                <Border Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Hedef Süre (sn):" VerticalAlignment="Center" FontSize="11" Foreground="#C5BEE8" Margin="0,0,6,0"/>
