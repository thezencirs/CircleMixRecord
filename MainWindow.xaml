<Window x:Class="CircleMixRecord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Circle — Studio by thezencirs"
        Width="1560" Height="920"
        MinWidth="1160" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="pack://application:,,,/CircleMixRecord.ico"
        Background="#140E38"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="RowTimeline" Height="220"/>
        </Grid.RowDefinitions>

        <!-- ======================= ÜST MINIMAL BAR (APPLE STUDIO LAYOUT) ======================= -->
        <Border Grid.Row="0" Background="#1C134C" BorderBrush="#342580" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Minimal Circle Logosu, Marka & Tek Satır Durum Kapsülü -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0" Background="#261A66" BorderBrush="#EF5F18" BorderThickness="1.5">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="18" Height="18" Stroke="#FFFFFF" StrokeThickness="2"/>
                            <Ellipse Width="7" Height="7" Fill="#EF5F18"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Circle" FontWeight="Bold" FontSize="15.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text="by thezencirs" FontSize="11" Foreground="#B8B0DC" VerticalAlignment="Center" Margin="7,1,16,0"/>

                    <!-- Minimal Canlı Sayaç & Sağlık Kapsülü -->
                    <Border x:Name="BdrRecBadge" Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotRecStatus" Width="7" Height="7" Fill="#FFFFFF" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="TxtRecTimer" Text="00:00:00" FontFamily="Consolas" FontWeight="SemiBold" FontSize="11.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Text="  •  " FontSize="10.5" Foreground="#342580" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtHealthBadge" Text="100%" FontSize="11" Foreground="#B8B0DC" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtEncoderBadge" Text="" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Orta: Apple Tarzı Numarasız, Yalın Segmented Control -->
                <Border Grid.Column="1" Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnModeRecord" Content="Stüdyo" Click="BtnModeRecord_Click"
                                Background="#EF5F18" BorderBrush="#EF5F18" Padding="18,5" Margin="1,0"/>
                        <Button x:Name="BtnModeEdit" Content="Kurgu" Click="BtnModeEdit_Click"
                                Background="#261A66" BorderBrush="Transparent" Padding="18,5" Margin="1,0"/>
                        <Button x:Name="BtnModeHome" Content="Genel Bakış" Click="BtnModeHome_Click"
                                Background="#261A66" BorderBrush="Transparent" Padding="16,5" Margin="1,0"/>
                        <Button x:Name="BtnModeSocial" Content="Paylaş" Click="BtnModeSocial_Click"
                                Background="#261A66" BorderBrush="Transparent" Padding="18,5" Margin="1,0"/>
                    </StackPanel>
                </Border>

                <!-- Sağ: Yalın Yardımcı Araçlar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkProView" Content="Denetçi" IsChecked="False"
                              Checked="ChkProView_Changed" Unchecked="ChkProView_Changed"
                              VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#B8B0DC"
                              ToolTip="Sahne, Ses, Kadraj ve Circle Meet denetçi panellerini göster/gizle"/>
                    <Button Content="Aç" Click="BtnOpenProject_Click" Padding="12,5" Margin="0,0,6,0" ToolTip="Video veya proje dosyası aç"/>
                    <Button Content="Klasör" Click="BtnOpenFolder_Click" Padding="12,5" Margin="0,0,6,0" ToolTip="Kayıt klasörünü aç"/>
                    <Button Content="?" Click="BtnShowShortcuts_Click" Width="30" Padding="0,5" ToolTip="Kısayollar ve Hakkında (thezencirs)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= ORTA ANA ÇALIŞMA ALANI ======================= -->
        <Grid Grid.Row="1" Margin="12,12,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeftPanel" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColRightPanel" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- 1A. SOL DENETÇİ (STÜDYO MODU): SAHNE, KAMERA VE SES -->
            <Border x:Name="BdrLeftPanel" Grid.Column="0" Background="#1C134C" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Sahneler" FontWeight="SemiBold" FontSize="12" Foreground="#B8B0DC" Margin="0,0,0,6"/>
                        <ListBox x:Name="LstScenes" Background="#140E38" BorderBrush="#342580" Foreground="#FFFFFF"
                                 Height="132" SelectionChanged="LstScenes_SelectionChanged" SelectedIndex="0" Margin="0,0,0,14">
                            <ListBoxItem Content="Eğitim + Köşe Kamera" Padding="8,5"/>
                            <ListBoxItem Content="Canlı Toplantı (Circle Meet)" Padding="8,5"/>
                            <ListBoxItem Content="Tam Ekran Çalışma" Padding="8,5"/>
                            <ListBoxItem Content="Dikey Split (Ekran + Kamera)" Padding="8,5"/>
                            <ListBoxItem Content="Sadece Kamera" Padding="8,5"/>
                        </ListBox>

                        <TextBlock Text="Kamera &amp; Ses Girişi" FontWeight="SemiBold" FontSize="12" Foreground="#B8B0DC" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbCameras" Grid.Column="0" Height="28" SelectionChanged="CmbCameras_SelectionChanged"/>
                            <Button Grid.Column="1" Content="↻" ToolTip="Cihazları Yenile" Click="BtnRefreshDevices_Click" Margin="5,0,0,0" Padding="9,2"/>
                        </Grid>

                        <ComboBox x:Name="CmbMicrophones" Height="28" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkShowScreen" Content="Ekran Yakalama" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkShowWebcam" Content="Köşe Kamera" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkMirrorWebcam" Content="Ayna Görünümü" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkNaturalWb" Content="Doğal Renk Dengesi" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkShowMeetTiles" Content="Toplantı Katılımcılarını Göster" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkRecord4K" Content="4K UHD (3840×2160) Kayıt" IsChecked="False" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>

                        <Grid Margin="0,8,0,2">
                            <TextBlock Text="Kamera Boyutu" FontSize="11.5" Foreground="#B8B0DC"/>
                            <TextBlock x:Name="TxtCamScaleVal" Text="%22" FontSize="11.5" FontWeight="SemiBold" Foreground="#EF5F18" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SldCamScale" Minimum="14" Maximum="38" Value="22" ValueChanged="SldCamScale_ValueChanged" Margin="0,0,0,14"/>

                        <Separator Background="#342580" Margin="0,2,0,12"/>

                        <TextBlock Text="Ses Seviyeleri" FontWeight="SemiBold" FontSize="12" Foreground="#B8B0DC" Margin="0,0,0,8"/>

                        <Border Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Mikrofon" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtMicDb" Text="-60 dB" FontSize="11" Foreground="#B8B0DC" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="BarMicLevel" Minimum="0" Maximum="60" Value="8" Height="5" Foreground="#EF5F18" Background="#261A66" BorderThickness="0" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkMuteMic" Content="Sessize Al" Checked="ChkMuteAudio_Changed" Unchecked="ChkMuteAudio_Changed" Margin="0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="9" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Masaüstü Sesi" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtSysDb" Text="-60 dB" FontSize="11" Foreground="#B8B0DC" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="BarSysLevel" Minimum="0" Maximum="60" Value="4" Height="5" Foreground="#FFFFFF" Background="#261A66" BorderThickness="0" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkMuteSys" Content="Sessize Al" Checked="ChkMuteAudio_Changed" Unchecked="ChkMuteAudio_Changed" Margin="0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 1B. SOL MEDYA KÜTÜPHANESİ (KURGU MODU): YALIN YATAY & DİKEY KLASÖRLER -->
            <Border x:Name="BdrCapCutMediaPool" Grid.Column="0" Background="#1C134C" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,10,0" Visibility="Collapsed"
                    AllowDrop="True" DragOver="CapCutDropZone_DragOver" Drop="CapCutDropZone_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Üst: Medya Kütüphanesi Başlığı & Aksiyonlar -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Medya Kütüphanesi" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <Button Content="↻" ToolTip="Klasörleri Yenile" Click="BtnRefreshCapCutFolders_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="11"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Yeni Proje" Click="BtnCapCutNewBlank_Click"
                                    Background="#261A66" BorderBrush="#342580" Padding="8,6" FontSize="11.5"/>
                            <Button Grid.Column="2" Content="+ İçe Aktar" Click="BtnImportExternalToPool_Click"
                                    Background="#EF5F18" BorderBrush="#EF5F18" Padding="8,6" FontSize="11.5"/>
                        </Grid>
                    </StackPanel>

                    <!-- Yatay (16:9) Kayıtlar -->
                    <Border Grid.Row="1" Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Yatay  16:9" FontWeight="SemiBold" FontSize="11.5" Foreground="#B8B0DC" VerticalAlignment="Center"/>
                                <Button Content="Klasör" Click="BtnOpenHorizFolder_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="10.5"/>
                            </Grid>
                            <ListBox x:Name="LstHorizFolderFiles" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"
                                     MouseDoubleClick="LstHorizFolderFiles_MouseDoubleClick"
                                     SelectionChanged="LstHorizFolderFiles_SelectionChanged"
                                     PreviewMouseLeftButtonDown="FolderList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="FolderList_PreviewMouseMove"/>
                        </Grid>
                    </Border>

                    <!-- Dikey (9:16) Kayıtlar -->
                    <Border Grid.Row="2" Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="10" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Dikey  9:16" FontWeight="SemiBold" FontSize="11.5" Foreground="#B8B0DC" VerticalAlignment="Center"/>
                                <Button Content="Klasör" Click="BtnOpenVertFolder_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="10.5"/>
                            </Grid>
                            <ListBox x:Name="LstVertFolderFiles" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"
                                     MouseDoubleClick="LstVertFolderFiles_MouseDoubleClick"
                                     SelectionChanged="LstVertFolderFiles_SelectionChanged"
                                     PreviewMouseLeftButtonDown="FolderList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="FolderList_PreviewMouseMove"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2A. ORTA SAHNE (STÜDYO MODU): YALIN 16:9 + 9:16 CANLI TUVAL VE YÜZEN KONTROL DOCK'U -->
            <Border x:Name="BdrLiveRecordPreview" Grid.Column="1" Background="#1C134C" BorderBrush="#342580" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Minimal Tuval Başlıkları -->
                    <Grid Grid.Row="0" Margin="2,0,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.68*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock Text="16:9 Yatay" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtBadge16x9" Text="1080p • 1.0x" FontSize="11.5" Foreground="#B8B0DC" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Column="2">
                            <TextBlock Text="9:16 Dikey" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtBadge9x16" Text="1080×1920" FontSize="11.5" Foreground="#B8B0DC" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>

                    <!-- İki Canlı Tuval -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.68*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#0B0720" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                            <Image x:Name="ImgPreview16x9" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                        </Border>

                        <Border Grid.Column="2" Background="#0B0720" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                            <Image x:Name="ImgPreview9x16" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                        </Border>
                    </Grid>

                    <!-- Apple Yüzen Kayıt Dock'u (Kısayollar ToolTip İçinde, Görsel Gürültü Sıfır) -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Border Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" Padding="8,6" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnStartStopRec" Content="● Kayıt"
                                        Click="BtnStartStopRec_Click" Background="#EF5F18" BorderBrush="#EF5F18"
                                        Padding="22,7" FontSize="12.5" Margin="2,0"
                                        ToolTip="İkili Kaydı Başlat / Bitir (Ctrl+Shift+R)"/>

                                <Button x:Name="BtnPauseRec" Content="Duraklat"
                                        Click="BtnPauseRec_Click" IsEnabled="False" Padding="14,7" Margin="2,0"
                                        ToolTip="Kaydı Duraklat / Devam Et (Ctrl+Shift+P)"/>

                                <Border Width="1" Background="#342580" Margin="8,4"/>

                                <Button x:Name="BtnToggleWebcamQuick" Content="Kamera"
                                        Click="BtnToggleWebcamQuick_Click" Padding="14,7" Margin="2,0"
                                        ToolTip="Kamerayı Göster / Gizle (Alt+Shift+C)"/>

                                <Button x:Name="BtnToggleSmartZoom" Content="2x Zoom"
                                        Click="BtnToggleSmartZoom_Click" Padding="14,7" Margin="2,0"
                                        ToolTip="Fare Odaklı 2x Smart-Zoom (Alt+Q)"/>

                                <Button x:Name="BtnToggleFollow" Content="Takip: Açık"
                                        Click="BtnToggleFollow_Click" Padding="14,7" Margin="2,0"
                                        ToolTip="İmleç Takibini Kilitle / Aç (Alt+E)"/>

                                <Button Content="Fotoğraf" Click="BtnTakeScreenshot_Click"
                                        Padding="14,7" Margin="2,0"
                                        ToolTip="Net Ekran Fotoğrafı Al (Ctrl+Shift+K / Alt+S)"/>

                                <Button Content="İşaret" Click="BtnAddMarker_Click"
                                        Padding="14,7" Margin="2,0"
                                        ToolTip="Zaman Çizelgesine Bölüm İşareti Ekle (Ctrl+Shift+M)"/>

                                <Border Width="1" Background="#342580" Margin="8,4"/>

                                <Button Content="Meet Odası"
                                        Click="BtnQuickStartMeet_Click" Background="#261A66" BorderBrush="#342580"
                                        Padding="15,7" Margin="2,0"
                                        ToolTip="6 Haneli Kodla Canlı Toplantı &amp; Uzaktan Bağlantı Odasını Aç"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TxtStatusBanner"
                                   Text="Hazır"
                                   HorizontalAlignment="Center" FontSize="11" Foreground="#B8B0DC" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2B. ORTA SAHNE (KURGU MODU): APPLE FINAL CUT TARZI YALIN MONİTÖR VE HIZ BARI -->
            <Border x:Name="BdrCapCutCenterMonitor" Grid.Column="1" Background="#1C134C" BorderBrush="#342580" BorderThickness="1" CornerRadius="14" Padding="14" Visibility="Collapsed"
                    AllowDrop="True" DragOver="CapCutDropZone_DragOver" Drop="CapCutDropZone_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Kurgu Üst Barı -->
                    <Grid Grid.Row="0" Margin="2,0,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtCapCutActiveFile" Grid.Column="0" Text="Video seçin veya sürükleyin" FontWeight="SemiBold" FontSize="12" Foreground="#B8B0DC" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnCapCutView16x9" Content="16:9" Click="BtnCapCutSwitch16x9_Click" Background="#EF5F18" BorderBrush="#EF5F18" Padding="12,4" FontSize="11.5" Margin="0,0,4,0"/>
                            <Button x:Name="BtnCapCutView9x16" Content="9:16" Click="BtnCapCutSwitch9x16_Click" Background="#140E38" BorderBrush="#342580" Padding="12,4" FontSize="11.5"/>
                        </StackPanel>
                    </Grid>

                    <!-- Video Oynatıcı Sahnesi -->
                    <Border Grid.Row="1" Background="#0B0720" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" ClipToBounds="True"
                            AllowDrop="True" DragOver="CapCutDropZone_DragOver" Drop="CapCutDropZone_Drop">
                        <Grid>
                            <!-- Yalın Boş Durum -->
                            <Border x:Name="BdrCapCutEmptyState" Background="Transparent" Padding="24" Visibility="Visible">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Kurgu &amp; Timelapse" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Sol kütüphaneden bir video seçin veya bu alana sürükleyin."
                                               FontSize="12.5" Foreground="#B8B0DC" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Video Seç" Click="BtnImportExternalToPool_Click" Background="#EF5F18" BorderBrush="#EF5F18" Padding="18,8" Margin="4,0"/>
                                        <Button Content="Yatay Klasör" Click="BtnOpenHorizFolder_Click" Padding="14,8" Margin="4,0"/>
                                        <Button Content="Dikey Klasör" Click="BtnOpenVertFolder_Click" Padding="14,8" Margin="4,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <MediaElement x:Name="CapCutMediaPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          Stretch="Uniform" ScrubbingEnabled="True" Visibility="Collapsed"
                                          MediaOpened="CapCutMediaPlayer_MediaOpened"
                                          MediaEnded="CapCutMediaPlayer_MediaEnded"
                                          MouseLeftButtonDown="CapCutMediaPlayer_MouseLeftButtonDown"/>

                            <Border x:Name="BdrCapCutSpeedBadge" Background="#DD261A66" BorderBrush="#EF5F18" BorderThickness="1" CornerRadius="8"
                                    Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Visibility="Collapsed">
                                <TextBlock x:Name="TxtCapCutSpeedBadge" Text="1.0x" FontWeight="SemiBold" FontSize="11.5" Foreground="#FFFFFF"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Alt Transport ve Timelapse Dock'u -->
                    <Border Grid.Row="2" Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sol: Kes, Sil, Geri Al -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Kes" Click="BtnSplitClip_Click" Padding="12,6" Margin="0,0,4,0" ToolTip="Seçili saniyeden böl (S / Ctrl+B)"/>
                                <Button Content="Sil" Click="BtnToggleDeleteClip_Click" Padding="12,6" Margin="0,0,4,0" ToolTip="Seçili klibi sil (Delete)"/>
                                <Button Content="Çoğalt" Click="BtnDuplicateClip_Click" Padding="11,6" Margin="0,0,4,0" ToolTip="Seçili klibi kopyala"/>
                                <Button Content="Geri Al" Click="BtnUndoEdit_Click" Padding="11,6" Margin="0,0,4,0" ToolTip="Son işlemi geri al (Ctrl+Z)"/>
                                <Button x:Name="BtnTogglePlayerMute" Content="Ses" Click="BtnTogglePlayerMute_Click" Padding="11,6" ToolTip="Oynatıcı sesini aç/kapat"/>
                            </StackPanel>

                            <!-- Orta: Oynatma -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="⏮" Click="BtnPlayerStart_Click" Padding="10,6" Margin="2,0" ToolTip="Başa sar"/>
                                <Button Content="-3s" Click="BtnPlayerBack_Click" Padding="10,6" Margin="2,0" ToolTip="3 saniye geri"/>
                                <Button x:Name="BtnPlayerPlayPause" Content="▶ Oynat" Click="BtnPlayerPlayPause_Click"
                                        Background="#EF5F18" BorderBrush="#EF5F18" Padding="20,6" FontWeight="Bold" Margin="4,0" ToolTip="Oynat / Duraklat (Space)"/>
                                <Button Content="+3s" Click="BtnPlayerForward_Click" Padding="10,6" Margin="2,0" ToolTip="3 saniye ileri"/>
                            </StackPanel>

                            <!-- Sağ: Hız & Timelapse -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
