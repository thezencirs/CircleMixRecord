                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. SAĞ PANEL: CIRCLE PORTRAIT, AUTO-CUT SESSİZLİK, PRO KURGU & CIRCLE MEET -->
            <Border x:Name="BdrRightPanel" Grid.Column="2" Background="#1C134C" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="10" Padding="8" Visibility="Collapsed">
                <TabControl x:Name="RightTabControl" Background="Transparent" BorderThickness="0">
                    <!-- SEKME 1: CIRCLE PORTRAIT & NON-DESTRUCTIVE UNCROP -->
                    <TabItem Header="Circle Portrait">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                            <StackPanel>
                                <TextBlock Text="CIRCLE NON-DESTRUCTIVE DİKEY KADRAJ" FontWeight="Bold" FontSize="11.5" Foreground="#EF5F18" Margin="0,4,0,6"/>
                                <TextBlock Text="Master 16:9 kaynak ve kamera hareketleri (.cmrproj) korunur. Kayıttan sonra bile dikey videoyu kayıpsız uzaklaştırabilir (Uncrop) ve kadrajı değiştirebilirsiniz."
                                           TextWrapping="Wrap" FontSize="11" Foreground="#C5BEE8" Margin="0,0,0,10"/>

                                <TextBlock Text="Dikey Kadraj Modu (9:16):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbPortraitLayout" Height="28" SelectedIndex="0" SelectionChanged="CmbPortraitLayout_SelectionChanged" Margin="0,0,0,12">
                                    <ComboBoxItem Content="1. Tam Dikey 9:16 (İmleç &amp; Odak Takipli)"/>
                                    <ComboBoxItem Content="2. Sinematik Blur Uncrop (16:9 Tam Görünüm)"/>
                                    <ComboBoxItem Content="3. Split Ekran (Üst Eğitim + Alt Kamera)"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Kayıpsız Uzaklaştırma (Uncrop Oranı):" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtUncropVal" Text="%0 (Tam 9:16)" FontSize="11" FontWeight="Bold" Foreground="#EF5F18" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldUncrop" Minimum="0" Maximum="100" Value="0" ValueChanged="SldUncrop_ValueChanged" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Yatay Kadraj Kaydırma (Pan X):" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtPanXVal" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldPanX" Minimum="-45" Maximum="45" Value="0" ValueChanged="SldPanX_ValueChanged" Margin="0,0,0,12"/>

                                <CheckBox x:Name="ChkAutoClickZoom" Content="Tıklanan Yerlere Otomatik Smart-Zoom Yap" IsChecked="True"
                                          Checked="SmartZoomOptions_Changed" Unchecked="SmartZoomOptions_Changed" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="16:9 Smart-Zoom Oranı (Alt+Q):" FontSize="11" Foreground="#C5BEE8"/>
                                    <TextBlock x:Name="TxtZoom16Val" Text="2.0x" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldZoom16" Minimum="1.2" Maximum="3.5" Value="2.0" ValueChanged="SmartZoomOptions_Changed" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="9:16 Dikey Zoom Oranı (Alt+Q):" FontSize="11" Foreground="#C5BEE8"/>
                                    <TextBlock x:Name="TxtZoom9Val" Text="1.75x" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldZoom9" Minimum="1.2" Maximum="3.0" Value="1.75" ValueChanged="SmartZoomOptions_Changed" Margin="0,0,0,14"/>

                                <Button Content="Master Kaynaktan Dikey Videoyu Yeniden Üret (Uncrop)"
                                        Click="BtnReRenderUncrop_Click" Background="#EF5F18" BorderBrush="#FFFFFF"
                                        Padding="10,9" Margin="0,0,0,6"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SEKME 2: CIRCLE AUTO-CUT SESSİZLİK KALDIRICI -->
                    <TabItem Header="Sessizlik Sil">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                            <StackPanel>
                                <TextBlock Text="CIRCLE AUTO-CUT SESSİZLİK KALDIRICI" FontWeight="Bold" FontSize="11.5" Foreground="#EF5F18" Margin="0,4,0,6"/>
                                <TextBlock Text="Mikrofon kanalını analiz eder. Sessiz kısımları ya kesip birleştirir (Ripple Delete) ya da 3D modelleme/çizim dersleri için silmeden 8x hızlandırır."
                                           TextWrapping="Wrap" FontSize="11" Foreground="#C5BEE8" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Sessizlik Ses Eşiği (dB Threshold):" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtSilenceDbVal" Text="-38 dB" FontSize="11" FontWeight="Bold" Foreground="#EF5F18" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldSilenceDb" Minimum="-55" Maximum="-18" Value="-38" ValueChanged="SilenceParams_Changed" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Minimum Sessizlik Süresi:" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtSilenceDurVal" Text="0.55 sn" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldSilenceDur" Minimum="0.20" Maximum="2.50" Value="0.55" ValueChanged="SilenceParams_Changed" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Kelime Koruma Payı (Padding):" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtSilencePadVal" Text="150 ms" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldSilencePad" Minimum="20" Maximum="350" Value="150" ValueChanged="SilenceParams_Changed" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="3D Modelleme Sessizlik Hızlandırma:" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtDeadAirSpeedVal" Text="8.0x Hız" FontSize="11" FontWeight="Bold" Foreground="#EF5F18" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldDeadAirSpeed" Minimum="2" Maximum="16" Value="8" ValueChanged="SilenceParams_Changed" Margin="0,0,0,12"/>

                                <Button Content="1. Mikrofon Kanalındaki Sessizlikleri Analiz Et"
                                        Click="BtnAnalyzeSilence_Click" Background="#261A66" BorderBrush="#3B2A94"
                                        Padding="10,8" Margin="0,0,0,8"/>

                                <Button Content="2A. Sessiz Kısımları Kes ve Birleştir (Ripple Delete)"
