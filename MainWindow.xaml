                                          MediaEnded="CircleEditMediaPlayer_MediaEnded"
                                          MouseLeftButtonDown="CircleEditMediaPlayer_MouseLeftButtonDown"/>

                            <Border x:Name="BdrCircleEditSpeedBadge" Background="#DD261A66" BorderBrush="#EF5F18" BorderThickness="1" CornerRadius="8"
                                    Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Visibility="Collapsed">
