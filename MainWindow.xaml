<Window x:Class="CircleMixRecord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Circle Studio — by thezencirs"
        Width="1560" Height="920"
        MinWidth="1160" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="pack://application:,,,/CircleMixRecord.ico"
        Background="#140E38"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="RowTimeline" Height="220"/>
        </Grid.RowDefinitions>

        <!-- ======================= ÜST MINIMAL BAR (CIRCLE STUDIO LAYOUT) ======================= -->
        <Border Grid.Row="0" Background="#1C134C" BorderBrush="#342580" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Minimal Circle Logosu, Marka & Tek Satır Durum Kapsülü -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0" Background="#261A66" BorderBrush="#EF5F18" BorderThickness="1.5">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="18" Height="18" Stroke="#FFFFFF" StrokeThickness="2"/>
                            <Ellipse Width="7" Height="7" Fill="#EF5F18"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Circle Studio" FontWeight="Bold" FontSize="15.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text="by thezencirs" FontSize="11" Foreground="#B8B0DC" VerticalAlignment="Center" Margin="7,1,16,0"/>

                    <!-- Minimal Canlı Sayaç & Sağlık Kapsülü -->
                    <Border x:Name="BdrRecBadge" Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotRecStatus" Width="7" Height="7" Fill="#FFFFFF" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="TxtRecTimer" Text="00:00:00" FontFamily="Consolas" FontWeight="SemiBold" FontSize="11.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Text="  •  " FontSize="10.5" Foreground="#342580" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtHealthBadge" Text="100%" FontSize="11" Foreground="#B8B0DC" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtEncoderBadge" Text="" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Orta: Circle Yalın Mod Seçici -->
                <Border Grid.Column="1" Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnModeRecord" Content="Stüdyo" Click="BtnModeRecord_Click"
                                Background="#EF5F18" BorderBrush="#EF5F18" Padding="18,5" Margin="1,0"/>
                        <Button x:Name="BtnModeEdit" Content="Kurgu" Click="BtnModeEdit_Click"
                                Background="#261A66" BorderBrush="Transparent" Padding="18,5" Margin="1,0"/>
                        <Button x:Name="BtnModeHome" Content="Genel Bakış" Click="BtnModeHome_Click"
                                Background="#261A66" BorderBrush="Transparent" Padding="16,5" Margin="1,0"/>
                        <Button x:Name="BtnModeSocial" Content="Paylaş" Click="BtnModeSocial_Click"
                                Background="#261A66" BorderBrush="Transparent" Padding="18,5" Margin="1,0"/>
                    </StackPanel>
                </Border>

                <!-- Sağ: Yalın Yardımcı Araçlar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkProView" Content="Denetçi" IsChecked="True"
                              Checked="ChkProView_Changed" Unchecked="ChkProView_Changed"
                              VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#B8B0DC"
                              ToolTip="Sahne, AI Kamera Stüdyosu, Mikrofon Pre-Amp ve 1+1+1 Eğitim Seti panellerini göster/gizle"/>
                    <Button Content="🎓 1+1+1 Eğitim Paketi" Click="BtnOpenCoursePackage_Click" Background="#261A66" BorderBrush="#EF5F18" Padding="11,5" Margin="0,0,6,0" ToolTip="Circle &amp; thezencirs 1+1+1 Saatlik Eğitim Seti Dokümantasyon, Kurulum ve Ders Argümanları Klasörünü Aç"/>
                    <Button Content="Aç" Click="BtnOpenProject_Click" Padding="12,5" Margin="0,0,6,0" ToolTip="Video veya proje dosyası aç"/>
                    <Button Content="Klasör" Click="BtnOpenFolder_Click" Padding="12,5" Margin="0,0,6,0" ToolTip="Kayıt klasörünü aç"/>
                    <Button Content="?" Click="BtnShowShortcuts_Click" Width="30" Padding="0,5" ToolTip="Kısayollar ve Hakkında (thezencirs)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= ORTA ANA ÇALIŞMA ALANI ======================= -->
        <Grid Grid.Row="1" Margin="12,12,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeftPanel" Width="285"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColRightPanel" Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- 1A. SOL DENETÇİ (STÜDYO MODU): SAHNE, AI KAMERA STÜDYOSU (ARKA PLAN + BENİ NETLE + KAMERA AÇISI) & MİKROFON PRE-AMP -->
            <Border x:Name="BdrLeftPanel" Grid.Column="0" Background="#1C134C" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,10,0" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Sahneler" FontWeight="SemiBold" FontSize="11.5" Foreground="#B8B0DC" Margin="0,0,0,4"/>
                        <ListBox x:Name="LstScenes" Background="#140E38" BorderBrush="#342580" Foreground="#FFFFFF"
                                 Height="108" SelectionChanged="LstScenes_SelectionChanged" SelectedIndex="0" Margin="0,0,0,10" FontSize="11">
                            <ListBoxItem Content="Eğitim + Köşe Kamera" Padding="7,4"/>
                            <ListBoxItem Content="Canlı Toplantı (Circle Meet)" Padding="7,4"/>
                            <ListBoxItem Content="Tam Ekran Çalışma" Padding="7,4"/>
                            <ListBoxItem Content="Dikey Split (Ekran + Kamera)" Padding="7,4"/>
                            <ListBoxItem Content="Sadece Kamera (İntro/Outro)" Padding="7,4"/>
                        </ListBox>

                        <TextBlock Text="Kamera &amp; Mikrofon Girişi" FontWeight="SemiBold" FontSize="11.5" Foreground="#B8B0DC" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbCameras" Grid.Column="0" Height="26" SelectionChanged="CmbCameras_SelectionChanged"/>
                            <Button Grid.Column="1" Content="↻" ToolTip="Cihazları Yenile" Click="BtnRefreshDevices_Click" Margin="5,0,0,0" Padding="8,2"/>
                        </Grid>

                        <ComboBox x:Name="CmbMicrophones" Height="26" SelectionChanged="CmbMicrophones_SelectionChanged" Margin="0,0,0,8"/>

                        <!-- AI ARKA PLAN TANIMA & DEĞİŞTİRME + BENİ NETLEME + KAMERA AÇISI -->
                        <Border Background="#140E38" BorderBrush="#EF5F18" BorderThickness="1" CornerRadius="9" Padding="9" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🎥 AI Kamera: Arka Plan, Netleme &amp; Açı" FontWeight="Bold" FontSize="11.5" Foreground="#FFFFFF" Margin="0,0,0,5"/>

                                <TextBlock Text="Arka Plan Tanıma &amp; Değiştirme" FontSize="10.5" Foreground="#B8B0DC" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbWebcamBgMode" Height="26" SelectedIndex="1" SelectionChanged="WebcamStudioOptions_Changed" Margin="0,0,0,5" FontSize="11">
                                    <ComboBoxItem Content="0 • Doğal Kamera (Orijinal)"/>
                                    <ComboBoxItem Content="1 • ✨ Stüdyo Bokeh Bulanık Arka Plan"/>
                                    <ComboBoxItem Content="2 • 🏛️ thezencirs Mimari Stüdyo"/>
                                    <ComboBoxItem Content="3 • 🎬 Circle Karanlık Spotlight"/>
                                    <ComboBoxItem Content="4 • ✂️ Şeffaf Silüet Kesim (Kutusuz)"/>
                                    <ComboBoxItem Content="5 • 🖼️ Özel Render / Görsel Arka Plan"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🎯 Arka Planı Tanı" Click="BtnCalibrateWebcamBg_Click" Padding="6,4" FontSize="10.5" ToolTip="Arka planı anlık analiz edip sizi arka plandan daha keskin ayırır"/>
                                    <Button Grid.Column="2" Content="🖼️ Görsel Seç" Click="BtnPickWebcamBgImage_Click" Padding="6,4" FontSize="10.5" ToolTip="Kameranızın arkasına kendi mimari renderınızı veya ofis görselinizi koyun"/>
                                </Grid>

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Beni Netle (Stüdyo Yüz Keskinliği)" FontSize="10.5" Foreground="#B8B0DC"/>
                                    <TextBlock x:Name="TxtSubjectSharpVal" Text="%75" FontSize="10.5" FontWeight="Bold" Foreground="#EF5F18" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldSubjectSharpness" Minimum="0" Maximum="100" Value="75" ValueChanged="WebcamStudioOptions_Changed" Margin="0,0,0,4"/>

                                <CheckBox x:Name="ChkStudioKeyLight" Content="💡 Yüz Aydınlatma (Stüdyo Işığı)" IsChecked="True" Checked="WebcamStudioOptions_Changed" Unchecked="WebcamStudioOptions_Changed" FontSize="10.5" Margin="0,0,0,6"/>

                                <Separator Background="#342580" Margin="0,2,0,6"/>

                                <TextBlock Text="Kamera Açısı &amp; Kadraj Ön Ayarı" FontSize="10.5" Foreground="#B8B0DC" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbCameraAnglePreset" Height="26" SelectedIndex="0" SelectionChanged="CmbCameraAnglePreset_SelectionChanged" Margin="0,0,0,5" FontSize="10.5">
                                    <ComboBoxItem Content="🎯 Göz Hizası Eğitim Portresi (1.22x)"/>
                                    <ComboBoxItem Content="📐 Geniş Stüdyo Açısı (1.00x)"/>
                                    <ComboBoxItem Content="🔍 Circle Yakın Portre (1.50x)"/>
                                    <ComboBoxItem Content="↗ Üstten Kamera Açısı Düzelt (Tilt -14%)"/>
                                    <ComboBoxItem Content="↘ Alttan Kamera Açısı Düzelt (Tilt +14%)"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Kamera Yakınlık (PTZ Zoom)" FontSize="10.5" Foreground="#B8B0DC"/>
                                    <TextBlock x:Name="TxtWebcamZoomVal" Text="1.22x" FontSize="10.5" FontWeight="SemiBold" Foreground="#EF5F18" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldWebcamZoom" Minimum="1.0" Maximum="2.3" Value="1.22" ValueChanged="WebcamStudioOptions_Changed" Margin="0,0,0,4"/>

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Göz Hizası Dikey Açı (Tilt Y)" FontSize="10.5" Foreground="#B8B0DC"/>
                                    <TextBlock x:Name="TxtWebcamTiltVal" Text="-4%" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldWebcamTiltY" Minimum="-35" Maximum="35" Value="-4" ValueChanged="WebcamStudioOptions_Changed" Margin="0,0,0,4"/>

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Yatay Merkezleme (Pan X) &amp; Eğim" FontSize="10.5" Foreground="#B8B0DC"/>
                                    <TextBlock x:Name="TxtWebcamPanVal" Text="0% • 0°" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SldWebcamPanX" Grid.Column="0" Minimum="-35" Maximum="35" Value="0" ValueChanged="WebcamStudioOptions_Changed" ToolTip="Kamera Yatay Kaydırma (Pan X)"/>
                                    <Slider x:Name="SldWebcamRoll" Grid.Column="2" Minimum="-15" Maximum="15" Value="0" ValueChanged="WebcamStudioOptions_Changed" ToolTip="Kamera Ufuk Eğimi Düzeltme (-15°..+15°)"/>
                                </Grid>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbWebcamShape" Grid.Column="0" Height="25" SelectedIndex="0" SelectionChanged="WebcamStudioOptions_Changed" FontSize="10.5" ToolTip="Kamera Çerçeve Şekli">
                                        <ComboBoxItem Content="Sinematik 16:9"/>
                                        <ComboBoxItem Content="Daire (Circle)"/>
                                        <ComboBoxItem Content="Dikey Portre"/>
                                    </ComboBox>
                                    <ComboBox x:Name="CmbWebcamCorner" Grid.Column="2" Height="25" SelectedIndex="0" SelectionChanged="WebcamStudioOptions_Changed" FontSize="10.5" ToolTip="Kamera Ekran Konumu">
                                        <ComboBoxItem Content="Sağ Alt"/>
                                        <ComboBoxItem Content="Sol Alt"/>
                                        <ComboBoxItem Content="Sağ Üst"/>
                                        <ComboBoxItem Content="Sol Üst"/>
                                        <ComboBoxItem Content="Sağ Orta Kart"/>
                                        <ComboBoxItem Content="Tam Ekran"/>
                                    </ComboBox>
                                </Grid>

                                <CheckBox x:Name="ChkWebcamAngleGuide" Content="📐 Göz Hizası (1/3) Açı Kılavuz Çizgisi" IsChecked="False" Checked="WebcamStudioOptions_Changed" Unchecked="WebcamStudioOptions_Changed" FontSize="10.5"/>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="ChkShowScreen" Content="Ekran Yakalama" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkShowWebcam" Content="Köşe Kamera" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkMirrorWebcam" Content="Ayna Görünümü" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkNaturalWb" Content="Doğal Renk Dengesi" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkShowMeetTiles" Content="Toplantı Katılımcılarını Göster" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkRecord4K" Content="4K UHD (3840×2160) Kayıt" IsChecked="False" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>

                        <Grid Margin="0,6,0,2">
                            <TextBlock Text="Kamera Boyutu" FontSize="11" Foreground="#B8B0DC"/>
                            <TextBlock x:Name="TxtCamScaleVal" Text="%24" FontSize="11" FontWeight="SemiBold" Foreground="#EF5F18" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SldCamScale" Minimum="14" Maximum="42" Value="24" ValueChanged="SldCamScale_ValueChanged" Margin="0,0,0,10"/>

                        <Separator Background="#342580" Margin="0,2,0,8"/>

                        <!-- STÜDYO MİKROFON PRE-AMP & SES YÜKSELTME -->
                        <TextBlock Text="🎙️ Stüdyo Mikrofon &amp; Ses Yükseltici" FontWeight="Bold" FontSize="11.5" Foreground="#FFFFFF" Margin="0,0,0,6"/>

                        <Border Background="#140E38" BorderBrush="#EF5F18" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Mikrofon Seviyesi (Canlı)" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtMicDb" Text="-12 dB" FontSize="11" FontWeight="Bold" Foreground="#EF5F18" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="BarMicLevel" Minimum="0" Maximum="60" Value="48" Height="6" Foreground="#EF5F18" Background="#261A66" BorderThickness="0" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Mikrofon Güçlendirme (Pre-Amp)" FontSize="10.5" Foreground="#B8B0DC"/>
                                    <TextBlock x:Name="TxtMicBoostVal" Text="+6 dB" FontSize="10.5" FontWeight="Bold" Foreground="#EF5F18" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldMicGainDb" Minimum="0" Maximum="30" Value="6" ValueChanged="MicAudioOptions_Changed" Margin="0,0,0,5"
                                        ToolTip="Kısık mikrofon sesini +30 dB'e kadar patlama yapmadan (Soft-Limiter ile) yükseltir"/>

                                <CheckBox x:Name="ChkAutoVoiceBoost" Content="🔊 Otomatik Ses Yükseltici (AGC)" IsChecked="False" Checked="MicAudioOptions_Changed" Unchecked="MicAudioOptions_Changed" FontSize="10.5" Margin="0,0,0,3"/>
                                <CheckBox x:Name="ChkNoiseGate" Content="🛡️ Dip Gürültü Kesici (Noise Gate)" IsChecked="False" Checked="MicAudioOptions_Changed" Unchecked="MicAudioOptions_Changed" FontSize="10.5" Margin="0,0,0,3"/>
                                <CheckBox x:Name="ChkMuteMic" Content="Mikrofonu Sessize Al" Checked="ChkMuteAudio_Changed" Unchecked="ChkMuteAudio_Changed" FontSize="10.5" Margin="0,0,0,7"/>

                                <Button x:Name="BtnTestMicVoice" Content="🎙️ Sesimi Test Et (3 sn Kaydet &amp; Dinle)" Click="BtnTestMicVoice_Click"
                                        Background="#EF5F18" BorderBrush="#EF5F18" FontWeight="Bold" Padding="8,6" FontSize="11"
                                        ToolTip="3 saniye konuşun; Circle Stüdyo sesinizi kaydedip yükseltilmiş net haliyle hemen size dinletsin"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="9" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Masaüstü Sesi" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtSysDb" Text="-60 dB" FontSize="11" Foreground="#B8B0DC" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="BarSysLevel" Minimum="0" Maximum="60" Value="4" Height="5" Foreground="#FFFFFF" Background="#261A66" BorderThickness="0" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkMuteSys" Content="Sessize Al" Checked="ChkMuteAudio_Changed" Unchecked="ChkMuteAudio_Changed" Margin="0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 1B. SOL MEDYA KÜTÜPHANESİ (KURGU MODU): YALIN YATAY & DİKEY KLASÖRLER -->
            <Border x:Name="BdrCircleEditMediaPool" Grid.Column="0" Background="#1C134C" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,10,0" Visibility="Collapsed"
                    AllowDrop="True" DragOver="CircleEditDropZone_DragOver" Drop="CircleEditDropZone_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Üst: Medya Kütüphanesi Başlığı & Aksiyonlar -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Medya Kütüphanesi" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <Button Content="↻" ToolTip="Klasörleri Yenile" Click="BtnRefreshCircleEditFolders_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="11"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Yeni Proje" Click="BtnCircleEditNewBlank_Click"
                                    Background="#261A66" BorderBrush="#342580" Padding="8,6" FontSize="11.5"/>
                            <Button Grid.Column="2" Content="+ İçe Aktar" Click="BtnImportExternalToPool_Click"
                                    Background="#EF5F18" BorderBrush="#EF5F18" Padding="8,6" FontSize="11.5"/>
                        </Grid>
                    </StackPanel>

                    <!-- Yatay (16:9) Kayıtlar -->
                    <Border Grid.Row="1" Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Yatay  16:9" FontWeight="SemiBold" FontSize="11.5" Foreground="#B8B0DC" VerticalAlignment="Center"/>
                                <Button Content="Klasör" Click="BtnOpenHorizFolder_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="10.5"/>
                            </Grid>
                            <ListBox x:Name="LstHorizFolderFiles" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"
                                     MouseDoubleClick="LstHorizFolderFiles_MouseDoubleClick"
                                     SelectionChanged="LstHorizFolderFiles_SelectionChanged"
                                     PreviewMouseLeftButtonDown="FolderList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="FolderList_PreviewMouseMove"/>
                        </Grid>
                    </Border>

                    <!-- Dikey (9:16) Kayıtlar -->
                    <Border Grid.Row="2" Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="10" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Dikey  9:16" FontWeight="SemiBold" FontSize="11.5" Foreground="#B8B0DC" VerticalAlignment="Center"/>
                                <Button Content="Klasör" Click="BtnOpenVertFolder_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="10.5"/>
                            </Grid>
                            <ListBox x:Name="LstVertFolderFiles" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"
                                     MouseDoubleClick="LstVertFolderFiles_MouseDoubleClick"
                                     SelectionChanged="LstVertFolderFiles_SelectionChanged"
                                     PreviewMouseLeftButtonDown="FolderList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="FolderList_PreviewMouseMove"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2A. ORTA SAHNE (STÜDYO MODU): YALIN 16:9 + 9:16 CANLI TUVAL VE YÜZEN KONTROL DOCK'U -->
            <Border x:Name="BdrLiveRecordPreview" Grid.Column="1" Background="#1C134C" BorderBrush="#342580" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Minimal Tuval Başlıkları -->
                    <Grid Grid.Row="0" Margin="2,0,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.68*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock Text="16:9 Yatay" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtBadge16x9" Text="1080p • 1.0x" FontSize="11.5" Foreground="#B8B0DC" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Column="2">
                            <TextBlock Text="9:16 Dikey" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF"/>
