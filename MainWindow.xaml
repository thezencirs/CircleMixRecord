                            <TextBlock Text="Başlık" FontSize="11.5" Foreground="#B8B0DC" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtSocialTitle" Text="3B Mimari Modelleme &amp; Tasarım — Circle Studio"
                                     Background="#140E38" Foreground="#FFFFFF" BorderBrush="#342580" Padding="9,7" FontSize="12.5" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Açıklama &amp; Bölümler" FontSize="11.5" Foreground="#B8B0DC"/>
                                <Button Content="Yenile" Click="BtnRegenerateSocialMeta_Click" HorizontalAlignment="Right" Padding="9,2" FontSize="10.5"/>
                            </Grid>
                            <TextBox x:Name="TxtSocialCaption" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="#140E38" Foreground="#FFFFFF" BorderBrush="#342580" Padding="9" FontSize="12" Margin="0,0,0,14"/>

                            <WrapPanel>
                                <Button Content="Videoları Dışa Aktar (16:9 + 9:16)" Click="BtnExportAll_Click"
                                        Background="#EF5F18" BorderBrush="#EF5F18" Padding="16,9" Margin="0,0,8,0"/>
                                <Button Content="Metni Kopyala" Click="BtnCopySocialText_Click" Padding="14,9"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Hızlı Gönder" FontSize="12.5" FontWeight="SemiBold" Foreground="#B8B0DC" Margin="0,0,0,10"/>

                            <Button Content="16:9 Geniş Ekran Platformu"
                                    Click="BtnShareYouTube_Click" Background="#261A66" BorderBrush="#EF5F18"
                                    Padding="14,11" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>

                            <Button Content="9:16 Dikey Video Akışı"
                                    Click="BtnShareInstagram_Click" Background="#261A66" BorderBrush="#342580"
                                    Padding="14,11" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>

                            <Button Content="9:16 Kısa Video Platformu"
                                    Click="BtnShareTikTok_Click" Background="#261A66" BorderBrush="#342580"
                                    Padding="14,11" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>

                            <Button Content="Masaüstü / Mesajlaşma"
                                    Click="BtnShareWhatsApp_Click" Background="#261A66" BorderBrush="#342580"
                                    Padding="14,11" Margin="0,0,0,14" HorizontalContentAlignment="Left"/>

                            <Button Content="Stüdyoya Dön" Click="BtnModeRecord_Click" Background="#140E38" Padding="12,8"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- ======================= ALT TIMELINE (YALIN VE NET) ======================= -->
        <Border x:Name="BdrTimelinePanel" Grid.Row="2" Background="#1C134C" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" Margin="12,4,12,10" Padding="12,8"
                AllowDrop="True" DragOver="CapCutDropZone_DragOver" Drop="CapCutDropZone_Drop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="6" Padding="9,3" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtTimelineTimecode" Text="00:00.0 / 00:00.0" FontFamily="Consolas" FontWeight="SemiBold" FontSize="11.5" Foreground="#FFFFFF"/>
                        </Border>
                        <Button x:Name="BtnTimelinePlayPause" Content="▶ Oynat" Click="BtnPlayerPlayPause_Click" Background="#EF5F18" BorderBrush="#EF5F18" Padding="12,4" Margin="0,0,5,0"/>
                        <Button Content="Kes" Click="BtnSplitClip_Click" Padding="10,4" Margin="0,0,5,0"/>
                        <Button Content="Sil" Click="BtnToggleDeleteClip_Click" Padding="10,4" Margin="0,0,5,0"/>
                        <Button Content="Sessizliği Kes" Click="BtnRippleDeleteSilence_Click" Padding="11,4" Margin="0,0,5,0"/>
                        <Button Content="8x Hız" Click="BtnSpeedUpSilence_Click" Padding="10,4" Margin="0,0,5,0"/>
                        <Button Content="Geri Al" Click="BtnUndoEdit_Click" Padding="10,4"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtTimelineStats" Grid.Column="1"
                               Text="Timeline"
                               VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" Foreground="#B8B0DC"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#261A66" BorderBrush="#FFFFFF" BorderThickness="1" Width="9" Height="9" CornerRadius="2" Margin="4,0"/>
                        <TextBlock Text="Klip " FontSize="11" Foreground="#B8B0DC" VerticalAlignment="Center"/>
                        <Border Background="#EF5F18" Width="9" Height="9" CornerRadius="2" Margin="8,0,4,0"/>
                        <TextBlock Text="Timelapse" FontSize="11" Foreground="#B8B0DC" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="9" ClipToBounds="True"
                        AllowDrop="True" DragOver="CapCutDropZone_DragOver" Drop="CapCutDropZone_Drop">
                    <Canvas x:Name="TimelineCanvas" Background="Transparent"
                            MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                            MouseMove="TimelineCanvas_MouseMove"
                            MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp"
                            SizeChanged="TimelineCanvas_SizeChanged"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
