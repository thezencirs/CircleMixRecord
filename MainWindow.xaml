                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="🎙️ Seslendirme" Click="BtnRecordVoiceover_Click" Padding="8,6"/>
                                            <Button Grid.Column="2" Content="🔊 Sesi Ayır (.WAV)" Click="BtnExtractAudio_Click" Padding="8,6"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

