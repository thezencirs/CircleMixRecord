                                    <TextBlock x:Name="TxtZoom9Val" Text="1.75x" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldZoom9" Minimum="1.1" Maximum="3.0" Value="1.75" ValueChanged="SmartZoomOptions_Changed" Margin="0,0,0,14"/>

