                                        </Grid>
                                        <ListBox x:Name="LstSubtitles" Background="#140E38" BorderBrush="#3B2A94" Foreground="#FFFFFF" Height="72" FontSize="10.5"/>
                                    </StackPanel>
                                </Border>

                                <Button Content="VİDEOLARI HAZIRLA VE PAYLAŞIM MERKEZİNE GEÇ"
                                        Click="BtnExportAll_Click" Background="#EF5F18" BorderBrush="#FFFFFF"
                                        Padding="10,10" FontWeight="Bold"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SEKME 4: CIRCLE MEET & CANLI YAYIN -->
                    <TabItem Header="Circle Meet">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                            <StackPanel>
                                <TextBlock Text="CIRCLE MEET — TEK KODLA TOPLANTI &amp; UZAKTAN BAĞLANTI" FontWeight="Bold" FontSize="11.5" Foreground="#EF5F18" Margin="0,4,0,6"/>

                                <!-- 1. Kendi 6 Haneli Kodum & Uzaktan Kontrol İzni -->
                                <Border Background="#261A66" BorderBrush="#EF5F18" BorderThickness="1.5" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="Circle 6 Haneli Bağlantı Kodunuz:" FontSize="11" Foreground="#C5BEE8"/>
                                                <TextBlock x:Name="TxtMyRoomCode" Text="482-915" FontSize="22" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                            <Button Content="Kodu Kopyala" Click="BtnCopyRoomCode_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EF5F18" BorderBrush="#FFFFFF" Padding="10,6"/>
                                        </Grid>

                                        <CheckBox x:Name="ChkAllowRemoteControl"
                                                  Content="Uzaktan Fare &amp; Klavye Kontrolüne İzin Ver (Circle Remote)"
                                                  IsChecked="False" Checked="ChkAllowRemoteControl_Changed" Unchecked="ChkAllowRemoteControl_Changed"
                                                  FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,2,0,8"/>

                                        <TextBlock Text="İnternet / Ağ Katılım Bağlantısı:" FontSize="10.5" Foreground="#C5BEE8"/>
                                        <TextBox x:Name="TxtMeetUrl" Text="http://localhost:5880/meet" IsReadOnly="True"
                                                 Background="#140E38" Foreground="#FFFFFF" BorderBrush="#3B2A94" FontWeight="Bold" Padding="6,4" Margin="0,3,0,6"/>
                                        <WrapPanel>
                                            <Button x:Name="BtnToggleMeet" Content="Canlı Odayı Aç" Click="BtnToggleMeet_Click" Background="#EF5F18" BorderBrush="#FFFFFF" Margin="0,0,6,4"/>
                                            <Button Content="Tarayıcıda Aç" Click="BtnOpenMeetBrowser_Click" Background="#140E38" Margin="0,0,6,4"/>
                                            <Button Content="Linki Kopyala" Click="BtnCopyMeetLink_Click" Background="#140E38" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Karşı Bilgisayara / Arkadaşının Odasına Kodla Bağlan -->
                                <Border Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Başka Bilgisayara / Circle Odasına Kodla Bağlan:" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtRemoteJoinCode" Grid.Column="0" Text="" ToolTip="6 haneli kodu (Örn: 482-915) veya linki yazın"
                                                     Background="#140E38" Foreground="#FFFFFF" BorderBrush="#3B2A94" FontWeight="Bold" FontSize="13.5" Padding="8,5" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Content="Kodla Bağlan" Click="BtnConnectByCode_Click" Background="#EF5F18" BorderBrush="#FFFFFF" Padding="12,5"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Circle Meet Sohbeti &amp; Söz İsteyen Katılımcılar:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ListBox x:Name="LstMeetChat" Background="#140E38" BorderBrush="#3B2A94" Foreground="#FFFFFF" Height="95" FontSize="11" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtInstructorChat" Grid.Column="0" Background="#140E38" Foreground="#FFFFFF" BorderBrush="#3B2A94" Padding="6,5" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Content="Gönder" Click="BtnSendMeetChat_Click"/>
                                </Grid>

                                <Separator Background="#3B2A94" Margin="0,2,0,8"/>

                                <TextBlock Text="CIRCLE RTMP CANLI YAYIN" FontWeight="Bold" FontSize="11" Foreground="#EF5F18" Margin="0,0,0,4"/>
                                <TextBlock Text="RTMP Sunucu + Yayın Anahtarı (rtmp://...):" FontSize="10.5" Foreground="#C5BEE8" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtRtmpUrl" Text="rtmp://a.rtmp.youtube.com/live2/" Background="#140E38" Foreground="#FFFFFF" BorderBrush="#3B2A94" Padding="6,5" Margin="0,0,0,8"/>
                                <Button x:Name="BtnToggleRtmp" Content="RTMP Canlı Yayını Başlat" Click="BtnToggleRtmp_Click" Background="#261A66" BorderBrush="#EF5F18" Padding="10,7"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ======================= KATMAN A: İLK GİRİŞ CIRCLE KARŞILAMA EKRANI (#261A66 • #EF5F18 • #FFFFFF) ======================= -->
            <Border x:Name="OverlayWelcome" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#F2140E38" CornerRadius="10" Visibility="Visible" Padding="36">
                <Border MaxWidth="980" MaxHeight="560" Background="#1C134C" BorderBrush="#3B2A94" BorderThickness="1.5" CornerRadius="16" Padding="32" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="CIRCLE MIX RECORD" FontSize="24" FontWeight="ExtraBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Kayıt, Canlı Toplantı (Circle Meet), Kurgu &amp; Timelapse Stüdyosu  •  by thezencirs" FontSize="13.5" Foreground="#C5BEE8" HorizontalAlignment="Center" Margin="0,0,0,26"/>

                        <UniformGrid Columns="2" Rows="2" Height="320">
                            <!-- Kart 1: Circle Dual Kayıt -->
                            <Border Background="#261A66" BorderBrush="#EF5F18" BorderThickness="1.5" CornerRadius="12" Margin="8" Padding="20">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="1. Circle Dual Kayıt (16:9 + 9:16)" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                        <TextBlock Text="Tek tuşla aynı anda hem 16:9 Yatay hem de 9:16 Dikey imleç takipli ve ayna kameralı stüdyo kaydı alır, ayrı klasörlere kaydeder."
                                                   TextWrapping="Wrap" FontSize="12" Foreground="#C5BEE8"/>
                                    </StackPanel>
                                    <Button Content="Circle Kayıt Ekranına Geç ➔" Click="BtnWelcomeStartRecord_Click"
                                            Background="#EF5F18" BorderBrush="#FFFFFF" VerticalAlignment="Bottom" Padding="12,9"/>
                                </Grid>
                            </Border>

                            <!-- Kart 2: Circle Meet & Uzaktan Bağlantı -->
                            <Border Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1.5" CornerRadius="12" Margin="8" Padding="20">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="2. Circle Meet &amp; Uzaktan Bağlantı" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                        <TextBlock Text="Başka hiçbir programa ihtiyaç duymadan 6 haneli Circle koduyla bağlanın, karşı ekranı yönetin veya kameralı toplantıyı kaydedin."
                                                   TextWrapping="Wrap" FontSize="11.5" Foreground="#C5BEE8" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtWelcomeJoinCode" Grid.Column="0" Text="" ToolTip="Arkadaşınızın 6 haneli Circle kodunu girin"
                                                     Background="#140E38" Foreground="#FFFFFF" BorderBrush="#3B2A94" FontWeight="Bold" Padding="7,5" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Content="Kodla Bağlan" Click="BtnWelcomeConnectByCode_Click" Background="#EF5F18" BorderBrush="#FFFFFF" Padding="10,5"/>
                                        </Grid>
                                    </StackPanel>
                                    <Button x:Name="BtnWelcomeStartMeet" Content="Kendi Odamı Aç &amp; Kodumu Paylaş ➔" Click="BtnWelcomeStartMeet_Click"
                                            Background="#140E38" BorderBrush="#EF5F18" VerticalAlignment="Bottom" Padding="12,9"/>
                                </Grid>
                            </Border>

                            <!-- Kart 3: Circle Edit & Timelapse -->
                            <Border Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1.5" CornerRadius="12" Margin="8" Padding="20">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="3. Circle Edit &amp; Timelapse Stüdyosu" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                        <TextBlock Text="Yatay ve Dikey klasörlerden sürükle-bırak ile kurgu yapın; oynatın, kesin, silin, sessiz boşlukları kaldırın veya 30x Timelapse üretin."
                                                   TextWrapping="Wrap" FontSize="12" Foreground="#C5BEE8"/>
                                    </StackPanel>
                                    <Button Content="Circle Edit Stüdyosunu Aç ➔" Click="BtnModeEdit_Click"
                                            Background="#140E38" BorderBrush="#EF5F18" VerticalAlignment="Bottom" Padding="12,9"/>
                                </Grid>
                            </Border>

                            <!-- Kart 4: Circle Paylaşım Merkezi -->
                            <Border Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1.5" CornerRadius="12" Margin="8" Padding="20">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="4. Circle Paylaşım Merkezi" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                        <TextBlock Text="Kurgulanan yatay ve dikey videolarınız için otomatik başlık, bölüm zaman damgaları ve etiketler üretip tek tıkla yayınlayın."
                                                   TextWrapping="Wrap" FontSize="12" Foreground="#C5BEE8"/>
                                    </StackPanel>
                                    <Button Content="Circle Paylaşım Merkezini Aç ➔" Click="BtnModeSocial_Click"
                                            Background="#140E38" BorderBrush="#EF5F18" VerticalAlignment="Bottom" Padding="12,9"/>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ======================= KATMAN B: CIRCLE PAYLAŞIM MERKEZİ ======================= -->
            <Border x:Name="OverlaySocial" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#F2140E38" CornerRadius="10" Visibility="Collapsed" Padding="24">
                <Border MaxWidth="1040" Background="#1C134C" BorderBrush="#EF5F18" BorderThickness="1.5" CornerRadius="14" Padding="26" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sol: Otomatik Başlık, Chapters & Etiket Editörü -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CIRCLE PAYLAŞIM &amp; YAYIN MERKEZİ" FontSize="18" FontWeight="ExtraBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                            <TextBlock Text="Videolarınız -14 LUFS ses dengelemesi ve kurgusuyla hazırlanır, açıklama ve etiketler otomatik panoya kopyalanır."
                                       FontSize="12" Foreground="#C5BEE8" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <TextBlock Text="Video Başlığı:" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtSocialTitle" Text="3B Mimari Modelleme &amp; Tasarım Uygulamalı Ders — Circle Studio"
                                     Background="#140E38" Foreground="#FFFFFF" BorderBrush="#3B2A94" Padding="8,6" FontSize="12.5" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="SEO Açıklama + Otomatik Bölüm Zaman Damgaları + Etiketler:" FontSize="11.5" FontWeight="SemiBold"/>
                                <Button Content="Otomatik Yenile" Click="BtnRegenerateSocialMeta_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="10.5"/>
                            </Grid>
                            <TextBox x:Name="TxtSocialCaption" Height="155" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="#140E38" Foreground="#FFFFFF" BorderBrush="#3B2A94" Padding="8" FontSize="12" Margin="0,0,0,12"/>

                            <WrapPanel>
                                <Button Content="1. Kurgulu Videoları Şimdi Hazırla (16:9 + 9:16)" Click="BtnExportAll_Click"
                                        Background="#EF5F18" BorderBrush="#FFFFFF" Padding="14,9" Margin="0,0,8,0"/>
                                <Button Content="Başlık &amp; Açıklamayı Kopyala" Click="BtnCopySocialText_Click" Padding="12,9"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Sağ: Tek Tıkla Gönderme Kartları -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="TEK TIKLA PLATFORMLARA GÖNDER" FontSize="13.5" FontWeight="Bold" Foreground="#EF5F18" Margin="0,0,0,10"/>

                            <Button Content="▸ 16:9 Yatay Videoyu Gönder (Geniş Ekran)"
                                    Click="BtnShareYouTube_Click" Background="#261A66" BorderBrush="#EF5F18"
                                    Padding="14,12" FontSize="12.5" Margin="0,0,0,10" HorizontalContentAlignment="Left"/>

                            <Button Content="▸ 9:16 Dikey Videoyu Gönder (Dikey Akış)"
                                    Click="BtnShareInstagram_Click" Background="#261A66" BorderBrush="#3B2A94"
                                    Padding="14,12" FontSize="12.5" Margin="0,0,0,10" HorizontalContentAlignment="Left"/>

                            <Button Content="▸ 9:16 Kısa Video Platformuna Gönder"
                                    Click="BtnShareTikTok_Click" Background="#261A66" BorderBrush="#3B2A94"
                                    Padding="14,12" FontSize="12.5" Margin="0,0,0,10" HorizontalContentAlignment="Left"/>

                            <Button Content="▸ Mesajlaşma / Masaüstü ile Paylaş"
                                    Click="BtnShareWhatsApp_Click" Background="#261A66" BorderBrush="#3B2A94"
                                    Padding="14,12" FontSize="12.5" Margin="0,0,0,14" HorizontalContentAlignment="Left"/>

                            <Button Content="⬅ Circle Stüdyo Ekranına Geri Dön" Click="BtnModeRecord_Click" Background="#140E38" Padding="10,8"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- ======================= ALT PANEL: CIRCLE ÇOK KATMANLI TIMELINE & SES DALGA FORMU ======================= -->
        <Border x:Name="BdrTimelinePanel" Grid.Row="2" Background="#1C134C" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="10" Margin="8,4,8,8" Padding="10,8"
                AllowDrop="True" DragOver="CapCutDropZone_DragOver" Drop="CapCutDropZone_Drop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Timeline Araç Çubuğu -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#140E38" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtTimelineTimecode" Text="00:00.0 / 00:00.0" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                        </Border>
                        <Button x:Name="BtnTimelinePlayPause" Content="▶ Oynat / Duraklat" Click="BtnPlayerPlayPause_Click" Background="#EF5F18" BorderBrush="#FFFFFF" Padding="9,4" Margin="0,0,6,0"/>
                        <Button Content="Kes / Böl (S)" Click="BtnSplitClip_Click" Padding="9,4" Margin="0,0,6,0"/>
                        <Button Content="Sil (Del)" Click="BtnToggleDeleteClip_Click" Padding="9,4" Margin="0,0,6,0"/>
                        <Button Content="Sessizliği Kes (Ripple)" Click="BtnRippleDeleteSilence_Click" Padding="9,4" Margin="0,0,6,0"/>
                        <Button Content="8x Timelapse" Click="BtnSpeedUpSilence_Click" Padding="9,4" Margin="0,0,6,0"/>
                        <Button Content="Geri Al (Ctrl+Z)" Click="BtnUndoEdit_Click" Padding="9,4"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtTimelineStats" Grid.Column="1"
                               Text="CIRCLE TIMELINE  •  V1 (16:9)  •  V2 (9:16)  •  T1 (Altyazı)  •  A1 (Ses Dalga Formu)"
                               VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" Foreground="#C5BEE8"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#261A66" BorderBrush="#FFFFFF" BorderThickness="1" Width="10" Height="10" CornerRadius="2" Margin="4,0"/>
                        <TextBlock Text="Normal " FontSize="11" Foreground="#C5BEE8" VerticalAlignment="Center"/>
                        <Border Background="#EF5F18" Width="10" Height="10" CornerRadius="2" Margin="6,0,4,0"/>
                        <TextBlock Text="Timelapse " FontSize="11" Foreground="#C5BEE8" VerticalAlignment="Center"/>
                        <Border Background="#140E38" BorderBrush="#3B2A94" BorderThickness="1" Width="10" Height="10" CornerRadius="2" Margin="6,0,4,0"/>
                        <TextBlock Text="Silinen" FontSize="11" Foreground="#C5BEE8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Çok Katmanlı İnteraktif Timeline ve Ses Dalga Formu Tuvali -->
                <Border Grid.Row="1" Background="#140E38" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="8" ClipToBounds="True"
                        AllowDrop="True" DragOver="CapCutDropZone_DragOver" Drop="CapCutDropZone_Drop">
                    <Canvas x:Name="TimelineCanvas" Background="Transparent"
                            MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                            MouseMove="TimelineCanvas_MouseMove"
                            MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp"
                            SizeChanged="TimelineCanvas_SizeChanged"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
