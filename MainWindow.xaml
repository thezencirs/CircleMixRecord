                            <Button x:Name="BtnCircleEditView16x9" Content="16:9" Click="BtnCircleEditSwitch16x9_Click" Background="#EF5F18" BorderBrush="#EF5F18" Padding="12,4" FontSize="11.5" Margin="0,0,4,0"/>
                            <Button x:Name="BtnCircleEditView9x16" Content="9:16" Click="BtnCircleEditSwitch9x16_Click" Background="#140E38" BorderBrush="#342580" Padding="12,4" FontSize="11.5"/>
                        </StackPanel>
                    </Grid>

                    <!-- Video Oynatıcı Sahnesi -->
                    <Border Grid.Row="1" Background="#0B0720" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" ClipToBounds="True"
