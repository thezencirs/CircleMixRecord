                                            <Button Grid.Column="2" Content="Hedef Süreye Sığdır" Click="BtnFitTargetDuration_Click" Background="#140E38" Padding="6,4"/>
                                        </Grid>

                                        <CheckBox x:Name="ChkAudioNoiseSuppress" Content="Circle AI Ses Gürültü Silme" IsChecked="True"/>
                                        <CheckBox x:Name="ChkAudioLufsNorm" Content="-14 LUFS Stüdyo Ses Dengeleme" IsChecked="True" Margin="0,3,0,6"/>

                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Altyazı Üret" Click="BtnGenerateSubtitles_Click" Background="#140E38" Margin="0,0,6,0" Padding="6,4"/>
