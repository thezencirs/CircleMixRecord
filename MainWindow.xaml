                                            <ComboBoxItem Content="Saat 2 • AI Fotogerçekçi Render (3 Yol)"/>
                                            <ComboBoxItem Content="Saat 3 • AI Sinematik Animasyon &amp; Kurgu (2 Yol)"/>
                                        </ComboBox>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="📂 Eğitim Klasörü" Click="BtnOpenCoursePackage_Click" Background="#EF5F18" BorderBrush="#EF5F18" FontWeight="Bold" Padding="7,5" FontSize="10.5"/>
                                            <Button Grid.Column="2" Content="📄 Rehberi Aç" Click="BtnOpenCourseGuideHtml_Click" Background="#261A66" BorderBrush="#342580" Padding="7,5" FontSize="10.5"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtCourseModuleHeader" Text="SAAT 1: AI MODELLEME &amp; KURULUMLAR (3 YOL)" FontWeight="Bold" FontSize="11.5" Foreground="#EF5F18" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtCoursePrompter" Height="310" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 Background="#0B0720" Foreground="#FFFFFF" BorderBrush="#342580" Padding="8" FontSize="10.8" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SEKME 1: KADRAJ -->
                    <TabItem Header="Kadraj">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                            <StackPanel>
                                <TextBlock Text="Dikey Kadraj (9:16)" FontWeight="SemiBold" FontSize="12" Foreground="#B8B0DC" Margin="0,4,0,6"/>
