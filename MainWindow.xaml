<Window x:Class="CircleMixRecord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Circle Mix Record — Studio by thezencirs"
        Width="1560" Height="920"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="pack://application:,,,/CircleMixRecord.ico"
        Background="#140E38"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="RowTimeline" Height="245"/>
        </Grid.RowDefinitions>

        <!-- ======================= ÜST CIRCLE STÜDYO ÇUBUĞU (#261A66 • #EF5F18 • #FFFFFF | SIFIR ÇAKIŞMA) ======================= -->
        <Border Grid.Row="0" Background="#1C134C" BorderBrush="#3B2A94" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Circle Logosu (#261A66 + #EF5F18 + #FFFFFF), Başlık & Alt Satırda Birleşik Sağlık/GPU Bilgisi (Çakışma Yok!) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0" Background="#261A66" BorderBrush="#EF5F18" BorderThickness="1.8">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="22" Height="22" Stroke="#FFFFFF" StrokeThickness="2.4"/>
                            <Ellipse Width="10" Height="10" Fill="#EF5F18"/>
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CIRCLE MIX RECORD" FontWeight="ExtraBold" FontSize="14" Foreground="#FFFFFF"/>
                            <TextBlock Text="  by thezencirs" FontWeight="Bold" FontSize="10.5" Foreground="#EF5F18" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtEncoderBadge" Text="Circle GPU Engine" FontSize="10.5" Foreground="#C5BEE8"/>
                            <TextBlock Text="  •  " FontSize="10.5" Foreground="#EF5F18" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtHealthBadge" Text="Sağlık: 100/100 (2.4ms)" FontWeight="Bold" FontSize="10.5" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="BdrRecBadge" Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="7" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotRecStatus" Width="8" Height="8" Fill="#EF5F18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtRecTimer" Text="HAZIR  00:00:00" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Orta: 4 Adımlı Circle Mod Seçici (Kompakt & Şık Segment Bar) -->
                <Border Grid.Column="1" Background="#140E38" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="9" Padding="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnModeHome" Content="1. Başlangıç" Click="BtnModeHome_Click"
                                Background="#EF5F18" BorderBrush="#FFFFFF" Padding="13,5" Margin="1,0"/>
                        <Button x:Name="BtnModeRecord" Content="2. Circle Kayıt &amp; Meet" Click="BtnModeRecord_Click"
                                Background="#261A66" BorderBrush="#3B2A94" Padding="13,5" Margin="1,0"/>
                        <Button x:Name="BtnModeEdit" Content="3. Circle Edit &amp; Timelapse" Click="BtnModeEdit_Click"
                                Background="#261A66" BorderBrush="#3B2A94" Padding="13,5" Margin="1,0"/>
                        <Button x:Name="BtnModeSocial" Content="4. Circle Paylaşım" Click="BtnModeSocial_Click"
                                Background="#261A66" BorderBrush="#3B2A94" Padding="13,5" Margin="1,0"/>
                    </StackPanel>
                </Border>

                <!-- Sağ: Kısayollar, Detay Görünüm & Klasör -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Kısayollar &amp; Hakkında" Click="BtnShowShortcuts_Click"
                            Background="#261A66" BorderBrush="#3B2A94" Padding="10,5" Margin="0,0,6,0"/>
                    <CheckBox x:Name="ChkProView" Content="Detay Paneller" IsChecked="False"
                              Checked="ChkProView_Changed" Unchecked="ChkProView_Changed"
                              VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <Button Content="Dosya Aç" Click="BtnOpenProject_Click" Padding="10,5" Margin="0,0,5,0"/>
                    <Button Content="Klasör" Click="BtnOpenFolder_Click" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= ORTA ANA ÇALIŞMA ALANI (SOL / ORTA / SAĞ) ======================= -->
        <Grid Grid.Row="1" Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeftPanel" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColRightPanel" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- 1A. SOL PANEL (KAYIT MODU): CIRCLE SAHNELER, KAMERA VE SES MİKSERİ -->
            <Border x:Name="BdrLeftPanel" Grid.Column="0" Background="#1C134C" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,6,0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CIRCLE SAHNELER" FontWeight="Bold" FontSize="11.5" Foreground="#EF5F18" Margin="0,0,0,6"/>
                        <ListBox x:Name="LstScenes" Background="#140E38" BorderBrush="#3B2A94" Foreground="#FFFFFF"
                                 Height="138" SelectionChanged="LstScenes_SelectionChanged" SelectedIndex="0" Margin="0,0,0,12">
                            <ListBoxItem Content="1. Eğitim + Köşe Ayna Kamera (Dual)" Padding="6,5"/>
                            <ListBoxItem Content="2. Canlı Toplantı (Circle Meet + Katılımcılar)" Padding="6,5"/>
                            <ListBoxItem Content="3. Tam Ekran 3D / CAD Modelleme" Padding="6,5"/>
                            <ListBoxItem Content="4. Dikey Split (Üst Ekran + Alt Kamera)" Padding="6,5"/>
                            <ListBoxItem Content="5. Sadece Eğitmen Kamerası" Padding="6,5"/>
                        </ListBox>

                        <TextBlock Text="KAMERA &amp; MİKROFON" FontWeight="Bold" FontSize="11.5" Foreground="#EF5F18" Margin="0,0,0,6"/>
                        <TextBlock Text="Kamera Seçimi:" FontSize="11" Foreground="#C5BEE8" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbCameras" Grid.Column="0" Height="28" SelectionChanged="CmbCameras_SelectionChanged"/>
                            <Button Grid.Column="1" Content="Yenile" ToolTip="Cihazları Yenile" Click="BtnRefreshDevices_Click" Margin="4,0,0,0" Padding="8,2"/>
                        </Grid>

                        <TextBlock Text="Mikrofon Seçimi:" FontSize="11" Foreground="#C5BEE8" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbMicrophones" Height="28" Margin="0,0,0,8"/>

                        <CheckBox x:Name="ChkShowScreen" Content="Masaüstü Ekran Yakalama" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkShowWebcam" Content="Köşe Kamera (Alt+Shift+C)" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkMirrorWebcam" Content="Ayna Kamera (Sağa Dönünce Sağa)" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkNaturalWb" Content="Doğal Beyaz Dengesi" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkShowMeetTiles" Content="Circle Meet Katılımcılarını Kayda Ekle" IsChecked="True" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>
                        <CheckBox x:Name="ChkRecord4K" Content="16:9 Kaydı 4K UHD (3840x2160) Üret" IsChecked="False" Checked="SourceOptions_Changed" Unchecked="SourceOptions_Changed"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="Köşe Kamera Boyutu:" FontSize="11" Foreground="#C5BEE8" Width="135"/>
                            <TextBlock x:Name="TxtCamScaleVal" Text="%22" FontSize="11" FontWeight="Bold" Foreground="#EF5F18"/>
                        </StackPanel>
                        <Slider x:Name="SldCamScale" Minimum="14" Maximum="38" Value="22" ValueChanged="SldCamScale_ValueChanged" Margin="0,0,0,12"/>

                        <Separator Background="#3B2A94" Margin="0,4,0,10"/>

                        <TextBlock Text="CIRCLE AYRIK SES KANALLARI" FontWeight="Bold" FontSize="11.5" Foreground="#EF5F18" Margin="0,0,0,8"/>

                        <Border Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Kanal 1: Mikrofon" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtMicDb" Text="-60 dB" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="BarMicLevel" Minimum="0" Maximum="60" Value="8" Height="7" Foreground="#EF5F18" Background="#140E38" BorderThickness="0" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkMuteMic" Content="Mikrofonu Sustur" Checked="ChkMuteAudio_Changed" Unchecked="ChkMuteAudio_Changed" Margin="0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="8" Padding="9">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Kanal 2: Sistem Sesi" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtSysDb" Text="-60 dB" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="BarSysLevel" Minimum="0" Maximum="60" Value="4" Height="7" Foreground="#FFFFFF" Background="#140E38" BorderThickness="0" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkMuteSys" Content="Sistem Sesini Sustur" Checked="ChkMuteAudio_Changed" Unchecked="ChkMuteAudio_Changed" Margin="0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 1B. SOL PANEL (CIRCLE EDIT MODU): AÇIK YATAY & DİKEY KLASÖRLER + SÜRÜKLE BIRAK MEDYA HAVUZU -->
            <Border x:Name="BdrCapCutMediaPool" Grid.Column="0" Background="#1C134C" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,6,0" Visibility="Collapsed"
                    AllowDrop="True" DragOver="CapCutDropZone_DragOver" Drop="CapCutDropZone_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Üst: Circle Medya Havuzu Başlığı & Boş Proje Butonu -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="CIRCLE MEDYA &amp; KLASÖRLER" FontWeight="ExtraBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <Button Content="Yenile" Click="BtnRefreshCapCutFolders_Click" HorizontalAlignment="Right" Padding="7,3" FontSize="10.5"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Boş Circle Kurgu" Click="BtnCapCutNewBlank_Click"
                                    Background="#261A66" BorderBrush="#3B2A94" Padding="6,6" FontSize="11"/>
                            <Button Grid.Column="2" Content="Dışarıdan Ekle" Click="BtnImportExternalToPool_Click"
                                    Background="#EF5F18" BorderBrush="#FFFFFF" Padding="6,6" FontSize="11"/>
                        </Grid>
                    </StackPanel>

                    <!-- Açık Klasör 1: YATAY (16:9) KAYITLAR KLASÖRÜ -->
                    <Border Grid.Row="1" Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,2">
                                <TextBlock Text="YATAY (16:9) KLASÖRÜ" FontWeight="Bold" FontSize="11" Foreground="#EF5F18" VerticalAlignment="Center"/>
                                <Button Content="Klasörü Aç" Click="BtnOpenHorizFolder_Click" HorizontalAlignment="Right" Padding="7,2" FontSize="10" Background="#1C134C"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Sürükleyip sağa/timeline'a bırakın veya çift tıklayın:" FontSize="10" Foreground="#C5BEE8" Margin="0,0,0,4"/>
                            <ListBox x:Name="LstHorizFolderFiles" Grid.Row="2" Background="#140E38" BorderBrush="#3B2A94" Foreground="#FFFFFF" FontSize="11"
                                     MouseDoubleClick="LstHorizFolderFiles_MouseDoubleClick"
                                     SelectionChanged="LstHorizFolderFiles_SelectionChanged"
                                     PreviewMouseLeftButtonDown="FolderList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="FolderList_PreviewMouseMove"/>
                        </Grid>
                    </Border>

                    <!-- Açık Klasör 2: DİKEY (9:16) KAYITLAR KLASÖRÜ -->
                    <Border Grid.Row="2" Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,2">
                                <TextBlock Text="DİKEY (9:16) KLASÖRÜ" FontWeight="Bold" FontSize="11" Foreground="#EF5F18" VerticalAlignment="Center"/>
                                <Button Content="Klasörü Aç" Click="BtnOpenVertFolder_Click" HorizontalAlignment="Right" Padding="7,2" FontSize="10" Background="#1C134C"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Sürükleyip sağa/timeline'a bırakın veya çift tıklayın:" FontSize="10" Foreground="#C5BEE8" Margin="0,0,0,4"/>
                            <ListBox x:Name="LstVertFolderFiles" Grid.Row="2" Background="#140E38" BorderBrush="#3B2A94" Foreground="#FFFFFF" FontSize="11"
                                     MouseDoubleClick="LstVertFolderFiles_MouseDoubleClick"
                                     SelectionChanged="LstVertFolderFiles_SelectionChanged"
                                     PreviewMouseLeftButtonDown="FolderList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="FolderList_PreviewMouseMove"/>
                        </Grid>
                    </Border>

                    <!-- Alt: Sürükle Bırak Bilgi Kutusu -->
                    <Border Grid.Row="3" Background="#261A66" BorderBrush="#EF5F18" BorderThickness="1" CornerRadius="8" Padding="8">
                        <TextBlock Text="Yatay ve Dikey klasörlerdeki dosyaları fareyle tutup doğrudan orta ekrana veya alt Timeline'a sürükleyebilirsiniz."
                                   FontSize="10.5" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 2A. ORTA PANEL (CIRCLE KAYIT MODU): YAN YANA 16:9 YATAY VE 9:16 DİKEY CANLI ÖNİZLEME -->
            <Border x:Name="BdrLiveRecordPreview" Grid.Column="1" Background="#1C134C" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Önizleme Üst Başlıkları -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.65*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="6" Padding="10,5">
                            <Grid>
                                <TextBlock Text="CIRCLE 16:9 YATAY STÜDYO" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="TxtBadge16x9" Text="1080p / 4K • Zoom: 1.0x" FontSize="10.5" Foreground="#EF5F18" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="6" Padding="10,5">
                            <Grid>
                                <TextBlock Text="CIRCLE 9:16 SMART PORTRAIT" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="TxtBadge9x16" Text="1080x1920 • İmleç Takibi" FontSize="10.5" Foreground="#EF5F18" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Yan Yana İki Canlı Tuval -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.65*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#0D0826" BorderBrush="#3B2A94" BorderThickness="1.5" CornerRadius="8" ClipToBounds="True">
                            <Image x:Name="ImgPreview16x9" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                        </Border>

                        <Border Grid.Column="2" Background="#0D0826" BorderBrush="#3B2A94" BorderThickness="1.5" CornerRadius="8" ClipToBounds="True">
                            <Image x:Name="ImgPreview9x16" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                        </Border>
                    </Grid>

                    <!-- Alt Canlı Kayıt, Toplantı ve Kısayol Kontrol Barı -->
                    <Border Grid.Row="2" Background="#140E38" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="BtnStartStopRec" Content="● İkili Kaydı Başlat (Ctrl+Shift+R)"
                                        Click="BtnStartStopRec_Click" Background="#EF5F18" BorderBrush="#FFFFFF"
                                        Padding="16,8" FontSize="12.5" Margin="3,2"/>

                                <Button x:Name="BtnPauseRec" Content="Duraklat (Ctrl+Shift+P)"
                                        Click="BtnPauseRec_Click" IsEnabled="False" Padding="11,8" Margin="3,2"/>

                                <Button Content="Circle Meet Odasını Aç &amp; Kopyala"
                                        Click="BtnQuickStartMeet_Click" Background="#261A66" BorderBrush="#EF5F18"
                                        Padding="13,8" FontSize="12" Margin="3,2"/>

                                <Button x:Name="BtnToggleSmartZoom" Content="Smart-Zoom: KAPALI (Alt+Q)"
                                        Click="BtnToggleSmartZoom_Click" Padding="11,8" Margin="3,2"/>

                                <Button x:Name="BtnToggleFollow" Content="İmleç Takibi: AÇIK (Alt+E)"
                                        Click="BtnToggleFollow_Click" Padding="11,8" Margin="3,2"/>

                                <Button x:Name="BtnToggleWebcamQuick" Content="Kamera: AÇIK (Alt+Shift+C)"
                                        Click="BtnToggleWebcamQuick_Click" Padding="11,8" Margin="3,2"/>

                                <Button Content="Ekran Resmi Al (Ctrl+Shift+K)" Click="BtnTakeScreenshot_Click"
                                        Padding="11,8" Margin="3,2"/>

                                <Button Content="Marker At (Ctrl+Shift+M)" Click="BtnAddMarker_Click"
                                        Padding="11,8" Margin="3,2"/>
                            </WrapPanel>

                            <TextBlock x:Name="TxtStatusBanner" Grid.Row="1"
                                       Text="Circle Mix Record hazır. Tek tuşla 16:9 yatay ve 9:16 dikey kayıt alabilir veya Circle Meet odası başlatabilirsiniz."
                                       HorizontalAlignment="Center" FontSize="11" Foreground="#C5BEE8" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2B. ORTA PANEL (CIRCLE EDIT MODU): KAYIT DEĞİL, TAMAMEN EDİTE ODAKLI CIRCLE KURGU & TIMELAPSE MONİTÖRÜ -->
            <Border x:Name="BdrCapCutCenterMonitor" Grid.Column="1" Background="#1C134C" BorderBrush="#3B2A94" BorderThickness="1.5" CornerRadius="10" Padding="12" Margin="0,0,6,0" Visibility="Collapsed"
                    AllowDrop="True" DragOver="CapCutDropZone_DragOver" Drop="CapCutDropZone_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Circle Kurgu Monitörü Üst Bilgi & Yatay/Dikey Geçiş Barı -->
                    <Border Grid.Row="0" Background="#261A66" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CIRCLE KURGU MONİTÖRÜ:  " FontWeight="ExtraBold" FontSize="11.5" Foreground="#EF5F18"/>
                                <TextBlock x:Name="TxtCapCutActiveFile" Text="Boş Circle Kurgu Ekranı (Soldaki Yatay/Dikey Klasörden Video Sürükleyin)" FontWeight="SemiBold" FontSize="11.5" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnCapCutView16x9" Content="16:9 Yatay Video" Click="BtnCapCutSwitch16x9_Click" Background="#EF5F18" BorderBrush="#FFFFFF" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                                <Button x:Name="BtnCapCutView9x16" Content="9:16 Dikey Video" Click="BtnCapCutSwitch9x16_Click" Background="#140E38" BorderBrush="#3B2A94" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="Yeni Kayda Dön" Click="BtnModeRecord_Click" Background="#140E38" BorderBrush="#EF5F18" Padding="10,4" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Circle Orta Video Sahnesi (Boş Kurgu Dropzone + Gerçek MediaElement Oynatıcı) -->
                    <Border Grid.Row="1" Background="#0D0826" BorderBrush="#3B2A94" BorderThickness="1.5" CornerRadius="10" ClipToBounds="True"
                            AllowDrop="True" DragOver="CapCutDropZone_DragOver" Drop="CapCutDropZone_Drop">
                        <Grid>
                            <!-- Boş Circle Kurgu Ekranı (Dosya Sürüklenmeden Önce Görünür) -->
                            <Border x:Name="BdrCapCutEmptyState" Background="#140E38" BorderBrush="#3B2A94" BorderThickness="1.5" CornerRadius="12" Margin="28" Padding="24" Visibility="Visible">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="CIRCLE KURGU &amp; TIMELAPSE STÜDYOSU" FontSize="18" FontWeight="ExtraBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Kayıt bittiğinde videolarınız otomatik olarak buraya yüklenir veya soldaki açık Yatay (16:9) ve Dikey (9:16) klasörlerden istediğiniz videoyu buraya sürükleyip bırakabilirsiniz."
                                               TextWrapping="Wrap" MaxWidth="540" TextAlignment="Center" FontSize="12" Foreground="#C5BEE8" Margin="0,0,0,18"/>
                                    <WrapPanel HorizontalAlignment="Center">
