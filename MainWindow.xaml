                                <Button Content="Sessiz Bölgeleri Hızlandır" Click="BtnSpeedUpSilence_Click"
                                        Margin="0,0,0,6" Padding="10,8"/>
                                <Button Content="Kesimleri Sıfırla" Click="BtnResetSilenceCuts_Click" Padding="8,6" Margin="0,0,0,10"/>

                                <Border Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtSilenceSummary" Text="Analiz hazır."
                                               FontSize="11" Foreground="#B8B0DC" TextWrapping="Wrap"/>
                                </Border>

                                <Border Background="#140E38" BorderBrush="#EF5F18" BorderThickness="1" CornerRadius="9" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="🎵 Müzik Ritim (Beat-Sync) &amp; Ses Araçları" FontWeight="SemiBold" FontSize="11.5" Foreground="#FFFFFF" Margin="0,0,0,6"/>
