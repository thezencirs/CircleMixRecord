            <!-- 3. SAĞ DENETÇİ: 1+1+1 EĞİTİM SETİ PROMPTER, KADRAJ, SESSİZLİK SİL, EFEKT & MEET -->
            <Border x:Name="BdrRightPanel" Grid.Column="2" Background="#1C134C" BorderBrush="#342580" BorderThickness="1" CornerRadius="12" Padding="10" Margin="10,0,0,0" Visibility="Visible">
                <TabControl x:Name="RightTabControl" Background="Transparent" BorderThickness="0">
                    <!-- SEKME 0: 1+1+1 SAATLİK EĞİTİM SETİ PROMPTER & DERS ARGÜMANLARI -->
                    <TabItem Header="🎓 1+1+1 Eğitim">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
                            <StackPanel>
                                <Border Background="#140E38" BorderBrush="#EF5F18" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,2,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Circle &amp; thezencirs 1+1+1 Eğitim Stüdyosu" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,2"/>
                                        <TextBlock Text="3 Saatlik Hızlandırılmış &amp; Zenginleştirilmiş Eğitim: AI Modelleme (3 Yol) + Render (3 Yol) + Sinematik Kurgu (2 Yol)" FontSize="10" Foreground="#B8B0DC" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                        <TextBlock Text="Aktif Ders Modülü Seçin:" FontSize="10.5" Foreground="#B8B0DC" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="CmbCourseModule" Height="28" SelectedIndex="0" SelectionChanged="CmbCourseModule_SelectionChanged" Margin="0,0,0,6" FontSize="11">
