                                        Padding="10,9" Margin="0,0,0,8"/>

                                <Button Content="2B. 3D Modelleme Modu: Silmeden 8x Hızlandır"
                                        Click="BtnSpeedUpSilence_Click" Background="#261A66" BorderBrush="#EF5F18"
                                        Padding="10,9" Margin="0,0,0,8"/>

                                <Button Content="Tüm Kesimleri Geri Al (Orijinale Dön)"
                                        Click="BtnResetSilenceCuts_Click" Padding="10,7" Margin="0,0,0,8"/>

                                <Border Background="#140E38" BorderBrush="#3B2A94" BorderThickness="1" CornerRadius="6" Padding="9">
                                    <TextBlock x:Name="TxtSilenceSummary"
                                               Text="Henüz sessizlik analizi çalıştırılmadı."
                                               TextWrapping="Wrap" FontSize="11" Foreground="#C5BEE8"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SEKME 3: CIRCLE KURGU, DIŞARIDAN MEDYA, MASKELEME & ALTYAZI -->
