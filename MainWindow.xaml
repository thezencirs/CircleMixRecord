                            <!-- Satır 1: Temel Oynatma & Kesme / Silme -->
                            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,6">
                                <Button Content="⏮ Başa Sar" Click="BtnPlayerStart_Click" Padding="10,6" Margin="3,2"/>
                                <Button Content="⏪ -3 sn" Click="BtnPlayerBack_Click" Padding="10,6" Margin="3,2"/>
                                <Button x:Name="BtnPlayerPlayPause" Content="▶ Oynat (Space)" Click="BtnPlayerPlayPause_Click"
                                        Background="#EF5F18" BorderBrush="#FFFFFF" Padding="18,6" FontSize="12.5" FontWeight="Bold" Margin="4,2"/>
                                <Button Content="⏩ +3 sn" Click="BtnPlayerForward_Click" Padding="10,6" Margin="3,2"/>
                                <Button Content="Kes / Böl (S)" Click="BtnSplitClip_Click"
                                        Background="#261A66" BorderBrush="#EF5F18" Padding="14,6" FontWeight="Bold" Margin="6,2,3,2"/>
                                <Button Content="Seçili Klibi Sil (Del)" Click="BtnToggleDeleteClip_Click"
                                        Background="#261A66" BorderBrush="#3B2A94" Padding="14,6" FontWeight="Bold" Margin="3,2"/>
                                <Button Content="Çoğalt" Click="BtnDuplicateClip_Click" Padding="10,6" Margin="3,2"/>
                                <Button Content="Geri Al (Ctrl+Z)" Click="BtnUndoEdit_Click" Padding="10,6" Margin="3,2"/>
