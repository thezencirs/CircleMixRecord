                                    <ComboBoxItem Content="⚡ Montage Eğrisi"/>
                                    <ComboBoxItem Content="🦸 Hero Eğrisi"/>
                                    <ComboBoxItem Content="🚀 Bullet Eğrisi"/>
                                    <ComboBoxItem Content="✂️ Jump Cut Eğrisi"/>
                                    <ComboBoxItem Content="💥 Flash In Eğrisi"/>
                                    <ComboBoxItem Content="✨ Flash Out Eğrisi"/>
                                    <ComboBoxItem Content="🎢 Ramp Eğrisi"/>
                                    <ComboBoxItem Content="⚡ Strobe Ritim"/>
                                </ComboBox>
                                <Button Content="Timelapse / Eğri Kaydet" Click="BtnRenderInstantTimelapse_Click"
                                        Background="#EF5F18" BorderBrush="#EF5F18" Padding="12,6" FontSize="11"
                                        ToolTip="Seçili sabit hızda veya dinamik hız eğrisinde 60 FPS akıcı MP4 üret"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
