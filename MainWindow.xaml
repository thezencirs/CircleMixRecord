                                <Button Content="0.5x" Click="BtnSpeed05x_Click" Padding="7,5" FontSize="11" Margin="1,0"/>
                                <Button Content="1x" Click="BtnSpeed1x_Click" Padding="7,5" FontSize="11" Margin="1,0"/>
                                <Button Content="2x" Click="BtnSpeed2x_Click" Padding="7,5" FontSize="11" Margin="1,0"/>
                                <Button Content="4x" Click="BtnSpeed4x_Click" Padding="7,5" FontSize="11" Margin="1,0"/>
                                <Button Content="8x" Click="BtnSpeed8x_Click" Padding="7,5" FontSize="11" Margin="1,0"/>
                                <Button Content="16x" Click="BtnSpeed16x_Click" Padding="7,5" FontSize="11" Margin="1,0"/>
