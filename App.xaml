<Application x:Class="CircleMixRecord.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ========================================================================= -->
        <!-- CIRCLE MIX RECORD — APPLE MINIMALISM PALETTE (#FFFFFF • #EF5F18 • #261A66) -->
        <!-- ========================================================================= -->
        <SolidColorBrush x:Key="CircleDeepBg" Color="#140E38"/>
        <SolidColorBrush x:Key="CirclePanelBg" Color="#1C134C"/>
        <SolidColorBrush x:Key="CircleScarlet" Color="#261A66"/>
        <SolidColorBrush x:Key="CircleBorder" Color="#342580"/>
        <SolidColorBrush x:Key="CircleOrange" Color="#EF5F18"/>
        <SolidColorBrush x:Key="CircleWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CircleSoftWhite" Color="#B8B0DC"/>

        <!-- Minimalist Apple-Style Pill Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#261A66"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#342580"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#EF5F18"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EF5F18"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#261A66"/>
            <Setter Property="Foreground" Value="#140E38"/>
            <Setter Property="BorderBrush" Value="#342580"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#140E38"/>
            <Setter Property="Foreground" Value="#B8B0DC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="#140E38" BorderBrush="#342580" BorderThickness="1" CornerRadius="7" Margin="2,0,2,6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EF5F18"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EF5F18"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
