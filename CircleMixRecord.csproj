<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>CircleMixRecord</AssemblyName>
    <RootNamespace>CircleMixRecord</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>thezencirs</Authors>
    <Company>thezencirs</Company>
    <Product>Circle Mix Record</Product>
    <Description>Circle Mix Record — Dual-Canvas (16:9 + 9:16) Screen Recorder, Circle Meet Remote Studio &amp; Circle Edit + Timelapse Video Editor by thezencirs</Description>
    <Copyright>Copyright (c) 2026 thezencirs. Licensed under the MIT License.</Copyright>
    <RepositoryUrl>https://github.com/thezencirs/CircleMixRecord</RepositoryUrl>
    <PackageProjectUrl>https://github.com/thezencirs/CircleMixRecord</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>CircleMixRecord.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="CircleMixRecord.ico" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
